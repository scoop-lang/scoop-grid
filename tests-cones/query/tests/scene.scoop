package scoop.grid.tests.query

import scoop.graphics.*
import scoop.grid.*
import scoop.surface.FrameSubmission
import scoop.ui.*
import scoop.ui.component.*

internal class QueryScene(private val probe: QueryProbe, scope: ComponentScope): Component(scope) {
    public override fun render(): View {
        val probe = this.probe
        return element(
            { mount -> QueryPanel(probe, mount) },
            [
                direction(
                    dataGrid(probe.model) {
                        height = 240.0
                        width = Some(360.0)
                        rowHeight = 32.0
                        headerHeight = 32.0
                        handle = Some(probe.handle)
                        multiSortModifier = probe.modifier.value
                        enabled = probe.enabled.value
                    },
                    probe.direction.value
                ),
                button("Outside", {}) { focus = FocusOptions(Some(probe.outside)) }
            ]
        )
    }
}

private class QueryPanel(private val probe: QueryProbe, scope: ComponentScope): Element<Unit>(
    scope
) {
    init {
        probe.frame = Some(scope)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        context.measureChild(0L, Constraints.tight(Size(360.0, 240.0)))
        context.placeChild(0L, Point(0.0, 0.0))
        context.measureChild(1L, Constraints.tight(Size(180.0, 40.0)))
        context.placeChild(1L, Point(0.0, 240.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(360.0, 280.0))), Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.children()
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.accepted()
        }
    }
}
