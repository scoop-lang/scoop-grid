package scoop.grid.tests.heights

import scoop.collections.*
import scoop.graphics.*
import scoop.grid.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.surface.ViewProbe
import scoop.tests.ui.accessibility.native.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme
import scoop.window.*
import scoop.window.native.*

@Test
private class GridRowHeightWindowTest {
    @Test
    fun `variable rows preserve reading and real cells across sizing editing and native requests`() {
        val probe = HeightProbe()
        try {
            context(probe.theme) {
                UiHost { host, active, event -> probe.event(host, active, event) }.use {
                    host -> Application().run(host)
                }
            }
            assertTrue(probe.finished)
            assertEquals(1, probe.discarded)
            assertEquals(0L, probe.live.size)
            assertTrue(probe.created < 3000L, Some(f"constructed ${probe.created} cells"))
            assertTrue(probe.reads.count < 1500L, Some(f"read ${probe.reads.count} rows"))
        } catch (error: Throwable) {
            println(
                f"heights phase=${probe.phase}, retry=${probe.retry}, created=${
                    probe.created
                }, reads=${probe.reads.count}, x=${probe.scroll.offset.x}, y=${
                    probe.scroll.offset.y
                }"
            )
            if (error is Exception)
                error.printStackTrace()
            throw error
        } finally {
            probe.close()
        }
    }
}

internal class HeightProbe: Closeable {
    val reads = HeightReads()
    var rows = HeightRows(reads)
    val theme = ThemeSource(shadcnTheme())
    val model = DataGridState(rows, heightColumns(this))
    val handle = DataGridHandle()
    val outside = FocusHandle()
    val scroll = ScrollState()
    val mode = state<GridRowSizing<HeightRow>>(GridRowSizing.Explicit(::explicitHeight))
    val baseHeight = state(32.0)
    val height = state(224.0)
    val direction = state(LayoutDirection.Ltr)
    val enabled = state(true)
    val live = HashSet<GridCellAddress>()
    val widthSamples = HashSet<GridCellAddress>()
    val rowHeights = HashMap<Long, Double>()
    var created = 0L
    var priorCreated = 0L
    var priorHeight = 0.0
    var revealed = false
    var beforeDiscard = Point(0.0, 0.0)
    var discardNext = false
    var discarded = 0
    var editor: GridTextEditor<Long>? = None
    var fit: GridColumnFit? = None
    var frame: ComponentScope? = None
    var active: ActiveApplication? = None
    var window: Window? = None
    var ui: UiWindow? = None
    var view: ViewProbe? = None
    var calls: NativeCalls? = None
    var root: NativeNode? = None
    var table: NativeNode? = None
    var retained: NativeNode? = None
    var offscreen: NativeNode? = None
    var phase = 0
    var waiting = false
    var retry = false
    var finished = false
    private val held = ArrayList<NativeNode>()
    init {
        resetColumns()
    }
    fun resetColumns() {
        model.setColumnStates(
            Array<GridColumnState>(30L) {
                column -> GridColumnState(
                    GridColumnId(f"c${column}"),
                    width =
                        if (column == 0L)
                            Some(80.0)
                        else
                            if (column == 29L)
                                Some(60.0)
                            else
                                None,
                    pin =
                        if (column == 0L)
                            GridPin.Start
                        else
                            if (column == 29L)
                                GridPin.End
                            else
                                GridPin.None
                )
            }
        )
    }
    fun replace(count: Long = 100000000L, extra: Double = 0.0, swapped: Boolean = false) {
        rows = HeightRows(reads, count, extra, swapped)
        model.replaceData(rows)
    }
    fun event(host: UiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active = Some(application)
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.now() + Duration.seconds(30L))
                )
                val native =
                    application.createWindow(
                        windowAttributes {
                            title = "Scoop Grid row heights";
                            size = LogicalSize(800.0, 440.0)
                        }
                    )
                window = Some(native)
                ui = host.attach(native, { scope -> HeightScene(this, scope) })
                @Unsafe
                {
                    native.acquireNativeWindow().use {
                        lease -> @Unsafe
                        {
                            when (lease.handle) {
                                case AppKit(_, val pointer) -> {
                                    root = Some(keep(NativeNode(nativeRoot(pointer)!!)))
                                    view = Some(ViewProbe(pointer))
                                }
                            }
                        }
                    }
                }
                calls =
                    Some(
                        NativeCalls(
                            application.proxy(),
                            { tag -> inspect(tag) },
                            { tag, result -> completed(tag, result) }
                        )
                    )
                native.requestFocus()
            }
            case Window(_, WindowEvent.Focused(true)) -> frame?.requestFrame()
            case NewEvents(StartCause.Deadline) -> fail(
                Some(f"heights timeout at ${phase}, focused=${window?.isFocused ?: false}")
            )
            else -> {}
        }
    }
    fun accepted() {
        if (finished || waiting || !(window?.isFocused ?: false))
            return
        waiting = true
        retry = false
        when (phase) {
            case 29 -> calls!!.post(offscreen!!, phase, 19)
            case 30 -> calls!!.post(offscreen!!, phase, 19, selectionStart = 1L)
            case 31 -> calls!!.post(offscreen!!, phase, 19, selectionStart = 1L)
            else -> calls!!.post(root!!, phase, 20)
        }
    }
    fun completed(tag: Int, result: Int) {
        assertEquals(phase, tag)
        waiting = false
        if (phase == 31) {
            if (result == 0) {
                frame!!.requestFrame()
                return
            }
            assertTrue(revealed, Some("revealed variable cell remains obscured"))
        }
        assertEquals(
            if (phase == 30)
                0
            else
                1,
            result,
            Some(f"native action at ${phase}")
        )
        if (retry) {
            frame!!.requestFrame();
            return
        }
        phase += 1
        advance()
        if (!finished && !waiting)
            frame!!.requestFrame()
    }
    fun keep(node: NativeNode): NativeNode {
        held.add(node);
        return node
    }
    fun cell(row: Long, column: Long): NativeNode = keep(table!!.cell(row, column)!!)
    fun findTable(node: NativeNode): NativeNode? {
        if (node.text(2, Some("AXTable")))
            return Some(node)
        for (index in 0L ..< node.count) {
            when (val found = findTable(keep(node.child(index)))) {
                case Some(_) -> return found;
                case None -> {}
            }
        }
        return None
    }
    public override fun close() {
        calls?.close()
        for (node in held)
            node.close()
        view?.close()
        ui?.close()
    }
}
