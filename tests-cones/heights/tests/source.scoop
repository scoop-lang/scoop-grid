package scoop.grid.tests.heights

import scoop.graphics.*
import scoop.grid.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.component.*

internal class HeightRow(val key: Long, val extra: Double)

internal class HeightReads {
    var count = 0L
}

internal class HeightRows(
    val reads: HeightReads,
    public override val count: Long = 100000000L,
    val extra: Double = 0.0,
    val swapped: Boolean = false
): TableSource<HeightRow> {
    private fun position(value: Long): Long =
        if (swapped && value < 2L)
            1L - value
        else
            value
    public override fun keyAt(index: Long): ViewKey = ViewKey.Number(position(index))
    public override fun rowAt(index: Long): HeightRow {
        reads.count += 1L
        val key = position(index)
        return HeightRow(
            key,
            if (key == 0L)
                extra
            else
                0.0
        )
    }
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Number(val value) -> if (value >= 0L && value < count)
                Some(position(value))
            else
                None
            else -> None
        }
}

internal fun explicitHeight(row: HeightRow): Double =
    when (row.key % 4L) {
        case 0L -> 32.0;
        case 1L -> 64.0;
        case 2L -> 48.0;
        else -> 96.0
    } +
        row.extra

internal fun heightAddress(row: Long, column: Long): GridCellAddress =
    GridCellAddress(ViewKey.Number(row), GridColumnId(f"c${column}"))

internal fun heightColumns(probe: HeightProbe): Array<GridColumn<HeightRow>> =
    Array<GridColumn<HeightRow>>(30L) {
        column ->
        val id = GridColumnId(f"c${column}")
        if (column == 23L)
            gridColumn<HeightRow, String>(
                id,
                "Wrapped text",
                { _ -> "This column wraps a long sentence across several lines in the grid." },
                gridTextValues(),
                TableColumnSize(GridTrack.Fixed(100.0), minimum = 40.0)
            )
        else
            gridColumn<HeightRow, Long>(
                id,
                f"Column ${column}",
                { row -> row.key },
                gridLongValues(),
                TableColumnSize(GridTrack.Fixed(100.0), minimum = 40.0),
                cell =
                    Some {
                        row -> element(
                            HeightBoxProps(
                                probe,
                                row,
                                column,
                                probe.theme.current.value.tokens.typography.body.fontSize / 14.0
                            ),
                            { props, scope -> HeightBox(props, scope) }
                        )
                    },
                edit =
                    if (column == 24L)
                        Some(
                            gridEdit<HeightRow, Long>(
                                {
                                    value ->
                                    val editor = gridLongEditor(value);
                                    probe.editor = Some(editor);
                                    editor
                                },
                                { _, completion -> completion.reject("read-only test service") }
                            )
                        )
                    else
                        None
            )
    }

private class HeightBoxProps(
    val probe: HeightProbe,
    val row: HeightRow,
    val column: Long,
    val density: Double
)

private class HeightBox(private val props: Props<HeightBoxProps>, scope: ComponentScope): Element<
    Unit
>(scope) {
    private val address = heightAddress(props.value.row.key, props.value.column)
    public override fun onMount() {
        assertTrue(props.value.probe.live.add(address), Some("duplicate mounted height cell"))
        props.value.probe.created += 1L
    }
    public override fun onUnmount() {
        assertTrue(props.value.probe.live.remove(address))
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val input = props.value
        val density = input.density
        if (constraints.maxWidth == None)
            input.probe.widthSamples.add(address)
        if (input.column == 0L && constraints.maxHeight != None)
            input.probe.rowHeights.put(input.row.key, constraints.maxHeight!! + 16.0 * density)
        val short = (constraints.maxWidth ?: 1000.0) >= 120.0 * density
        val contentHeight =
            if (short)
                20.0 + (input.row.key % 3L).toDouble() * 10.0
            else
                40.0 + (input.row.key % 3L).toDouble() * 20.0
        return LayoutResult(
            LayoutMetrics(
                constraints.constrain(
                    Size(
                        (120.0 + (input.row.key % 3L).toDouble() * 20.0) * density,
                        contentHeight * density
                    )
                )
            ),
            Unit
        )
    }
    public override fun scene(context: SceneContext, value: Unit) {
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        context.draw { paint -> paint.canvas.drawRect(bounds, Paint(Color(0.3, 0.55, 0.75, 1.0))) }
    }
}
