package scoop.grid.tests.aggregation

import scoop.graphics.*
import scoop.grid.*
import scoop.surface.FrameSubmission
import scoop.ui.*

internal class AggregationScene(
    private val probe: AggregationProbe,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View {
        val probe = this.probe
        val columns =
            if (probe.localized.value)
                GridColumnsLabels(
                    noAggregation = "Disabled",
                    aggregationName = { name -> f"Aggregate:${name}" }
                )
            else
                GridColumnsLabels()
        val totals =
            if (probe.localized.value)
                GridAggregationLabels(
                    records = { count -> f"Records:${count}" },
                    value = { column, operation, value -> f"${column}|${operation}|${value}" },
                    missing = "Empty",
                    error = { _ -> "Failed" }
                )
            else
                GridAggregationLabels()
        return element(
            { scope -> AggregationLayout(probe, scope) },
            [
                gridColumnsPanel(probe.model, probe.handle) {
                    height = 100.0;
                    enabled = probe.enabled.value;
                    labels = columns
                },
                gridQuickFilter(probe.model) { handle = Some(probe.handle) },
                dataGrid(probe.model) {
                    width = Some(620.0)
                    height = 620.0
                    rowHeight = 48.0
                    handle = Some(probe.handle)
                    enabled = probe.enabled.value
                    footer = Some(gridAggregationSummary(probe.model) { labels = totals })
                }
            ]
        )
    }
}

private class AggregationLayout(
    private val probe: AggregationProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    init {
        probe.frame = Some(scope)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        context.measureChild(0L, Constraints.tight(Size(300.0, 700.0)))
        context.placeChild(0L, Point(0.0, 0.0))
        context.measureChild(1L, Constraints.tight(Size(620.0, 48.0)))
        context.placeChild(1L, Point(320.0, 0.0))
        context.measureChild(2L, Constraints.tight(Size(620.0, 620.0)))
        context.placeChild(2L, Point(320.0, 60.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(960.0, 720.0))), Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.children()
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.accepted()
        }
    }
}
