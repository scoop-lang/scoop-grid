package scoop.grid.tests.aggregation

import scoop.grid.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.ui.accessibility.native.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme
import scoop.window.*
import scoop.window.native.*

@Test
private class GridAggregationWindowTest {
    @Test
    fun `native aggregate choices share queries editing and full-result totals`() {
        val probe = AggregationProbe()
        try {
            context(ThemeSource(shadcnTheme())) {
                UiHost { host, active, event -> probe.event(host, active, event) }.use {
                    host -> Application().run(host)
                }
            }
            assertTrue(probe.finished)
            assertFalse(probe.handle.isAttached)
            assertEquals(1, probe.submissions)
        } catch (error: Throwable) {
            println(probe.diagnostic)
            reportAggregationFailure(error)
            throw error
        } finally {
            probe.close()
        }
    }
    @Test
    fun `native logical totals share cells focus and retirement without business callbacks`() {
        val probe = AggregationProbe(true)
        try {
            context(ThemeSource(shadcnTheme())) {
                UiHost { host, active, event -> probe.event(host, active, event) }.use {
                    host -> Application().run(host)
                }
            }
            assertTrue(probe.finished)
            assertFalse(probe.handle.isAttached)
            assertEquals(0, probe.submissions)
        } catch (error: Throwable) {
            println(probe.diagnostic)
            reportAggregationFailure(error)
            throw error
        } finally {
            probe.close()
        }
    }
}

private fun reportAggregationFailure(error: Throwable) {
    if (error is ResourceUseException) {
        reportAggregationFailure(error.primaryFailure)
        reportAggregationFailure(error.cleanupFailure)
    } else
        if (error is AssertionFailure) {
            println(
                f"${error.location.file}:${error.location.line}: ${error.message ?: "assertion"}"
            )
        } else
            if (error is Exception) {
                error.printStackTrace()
            }
}

internal fun aggregateRows(values: Array<Long>): TableRows<Long> =
    TableRows(
        Array<TableRecord<Long>>(values.size) {
            index -> TableRecord(ViewKey.Number(index), values[index])
        }
    )

internal class AggregationProbe(val logical: Boolean = false): Closeable {
    val handle = DataGridHandle()
    val enabled = state(true)
    val localized = state(false)
    var editor: GridTextEditor<Long>? = None
    var options: GridEditorOptions? = None
    var pending: GridCommit<Long>? = None
    var submissions = 0
    var changes = 0
    val model =
        DataGridState(
            aggregateRows([4L, 1L, 3L, 2L]),
            columns(),
            GridQuery(
                pagination = GridPagination.Page(0L, 2L),
                aggregations =
                    if (logical)
                        [GridAggregationSelection(GridColumnId("amount"), GridAggregateId("sum"))]
                    else
                        [],
                totals =
                    if (logical)
                        GridTotals(GridTotalPlacement.After, "Grand total")
                    else
                        GridTotals()
            ),
            Some { _ -> changes += 1 },
            rowSelection =
                if (logical)
                    GridRowSelectionMode.Multiple
                else
                    GridRowSelectionMode.Disabled
        )
    val address = GridCellAddress(ViewKey.Number(1L), GridColumnId("amount"))
    var totals: GridAggregations? = None
    var selector: NativeNode? = None
    var option: NativeNode? = None
    var quick: NativeNode? = None
    var apply: NativeNode? = None
    var category: NativeNode? = None
    var amount: NativeNode? = None
    var summary: NativeNode? = None
    var totalTable: NativeNode? = None
    var totalCell: NativeNode? = None
    var totalRow: NativeNode? = None
    var retiredTotal: NativeNode? = None
    val totalAddress =
        GridCellAddress(GridRowKey.Total(GridTotalKey.AllFiltered), GridColumnId("amount"))
    var frame: ComponentScope? = None
    var active: ActiveApplication? = None
    var window: Window? = None
    var ui: UiWindow? = None
    var root: NativeNode? = None
    var calls: NativeCalls? = None
    var phase = 0
    var waiting = false
    var retry = false
    var finished = false
    val focused: Boolean get() = options?.focus?.hasFocus ?: false
    val diagnostic: String get() =
        f"aggregation phase=${phase}, waiting=${waiting}, retry=${retry}, focus=${
            focused
        }, pending=${handle.isSubmitting}, changes=${changes}, error=${handle.editError ?: "none"}"
    private val retained = ArrayList<NativeNode>()
    private val timeout = MonotonicTimeSource.now() + Duration.seconds(30L)

    private fun columns(): Array<GridColumn<Long>> {
        val probe = this
        return [
            gridColumn<Long, Long>(
                GridColumnId("amount"),
                "Amount",
                { value -> value },
                gridLongValues(),
                TableColumnSize(GridTrack.Fixed(180.0)),
                edit =
                    Some(
                        gridEdit<Long, Long>(
                            {
                                value ->
                                val editor = gridLongEditor(value)
                                probe.editor = Some(editor)
                                AggregationEditor(editor, probe)
                            },
                            {
                                _, completion ->
                                probe.submissions += 1;
                                probe.pending = Some(completion)
                            }
                        )
                    ),
                aggregations =
                    [
                        gridCountAggregation<Long>(),
                        gridSumLongAggregation(),
                        gridAverageLongAggregation()
                    ]
            ),
            gridColumn<Long, String>(
                GridColumnId("category"),
                "Category",
                {
                    value -> if (value > 2L)
                        "keep"
                    else
                        "drop"
                },
                gridTextValues()
            )
        ]
    }
    fun event(host: UiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active = Some(application)
                application.setControlFlow(ControlFlow.WaitUntil(timeout))
                val native =
                    application.createWindow(
                        windowAttributes {
                            title = "Scoop Grid aggregation"
                            size = LogicalSize(960.0, 720.0)
                        }
                    )
                window = Some(native)
                ui = host.attach(native, { scope -> AggregationScene(this, scope) })
                @Unsafe
                {
                    native.acquireNativeWindow().use {
                        lease -> @Unsafe
                        {
                            when (lease.handle) {
                                case AppKit(_, val pointer) -> root =
                                    Some(keep(NativeNode(nativeRoot(pointer)!!)))
                            }
                        }
                    }
                }
                calls =
                    Some(
                        NativeCalls(application.proxy(), { tag -> inspect(tag) }) {
                            tag,
                            result -> completed(tag, result)
                        }
                    )
                native.requestFocus()
            }
            case Window(_, WindowEvent.Focused(true)) -> frame?.requestFrame()
            case NewEvents(StartCause.Deadline) -> fail(Some(diagnostic))
            else -> {}
        }
    }
    fun keep(node: NativeNode): NativeNode {
        retained.add(node)
        return node
    }
    fun named(id: String): NativeNode =
        keep(root!!.find(id) ?: fail(Some(f"missing ${id} at ${phase}")))
    fun findMenu(node: NativeNode, title: String): NativeNode? {
        if (node.flag(0) && node.text(2, Some("AXMenuItem")) && node.text(0, Some(title)))
            return Some(node)
        for (index in 0L ..< node.count) {
            val found = findMenu(keep(node.child(index)), title)
            when (found) {
                case Some(_) -> return found
                case None -> {}
            }
        }
        return None
    }
    fun prepareMenu(title: String) {
        option = findMenu(root!!, title)
        retry = !(option?.flag(1) ?: false)
    }
    fun total(text: String) {
        assertTrue(
            named("grid-aggregate-amount").text(1, Some(text)),
            Some(f"summary at ${phase}: ${text}")
        )
    }
    public override fun close() {
        calls?.close()
        for (node in retained)
            node.close()
    }
}

private class AggregationEditor(
    private val editor: GridTextEditor<Long>,
    private val probe: AggregationProbe
): GridEditor<Long> {
    public override val composing: Boolean get() = editor.composing
    public override fun candidate(): GridCandidate<Long> = editor.candidate()
    public override fun importText(text: String): String? = editor.importText(text)
    public override fun cancelComposition() {
        editor.cancelComposition()
    }
    public override fun view(options: GridEditorOptions): View {
        probe.options = Some(options)
        return editor.view(options)
    }
}
