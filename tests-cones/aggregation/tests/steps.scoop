package scoop.grid.tests.aggregation

import scoop.grid.*
import scoop.test.*
import scoop.ui.*

internal fun AggregationProbe.accepted() {
    if (logical)
        return acceptedTotal()
    if (finished || waiting || !(window?.isFocused ?: false))
        return
    waiting = true
    retry = false
    when (phase) {
        case 1 -> calls!!.post(selector!!, phase)
        case 8 -> calls!!.post(selector!!, phase)
        case 12 -> calls!!.post(selector!!, phase)
        case 15 -> when (option) {
            case Some(_) -> calls!!.post(root!!, phase, 20)
            case None -> calls!!.post(selector!!, phase)
        }
        case 25 -> calls!!.post(selector!!, phase)
        case 29 -> calls!!.post(selector!!, phase)
        case 37 -> calls!!.post(selector!!, phase)
        case 39 -> calls!!.post(selector!!, phase)
        case 3 -> calls!!.post(option!!, phase)
        case 17 -> calls!!.post(option!!, phase)
        case 27 -> calls!!.post(option!!, phase)
        case 31 -> calls!!.post(option!!, phase)
        case 10 -> when (option) {
            case Some(val value) -> calls!!.post(value, phase)
            case None -> calls!!.post(root!!, phase, 20)
        }
        case 20 -> calls!!.post(quick!!, phase, 1, "keep")
        case 21 -> calls!!.post(apply!!, phase)
        case 33 -> calls!!.post(category!!, phase)
        case 35 -> calls!!.post(amount!!, phase)
        else -> calls!!.post(root!!, phase, 20)
    }
}

internal fun AggregationProbe.inspect(tag: Int) {
    if (logical)
        return inspectTotal(tag)
    assertEquals(phase, tag)
    when (phase) {
        case 0 -> {
            selector = Some(named("grid-columns-amount-aggregation"))
            quick = Some(named("grid-quick-filter-input"))
            apply = Some(named("grid-quick-filter-apply"))
            category = Some(named("grid-columns-category-choose"))
            amount = Some(named("grid-columns-amount-choose"))
            assertEquals(None, model.aggregation(GridColumnId("amount")))
            assertTrue(named("grid-aggregate-count").text(1, Some("筛选结果总计 · 4 条记录")))
        }
        case 2 -> prepareMenu("总和")
        case 4 -> {
            total("Amount · 总和：10")
            assertEquals(Some(GridAggregateId("sum")), model.aggregation(GridColumnId("amount")))
            assertEquals(1, changes)
            totals = Some(model.result.aggregates)
        }
        case 5 -> {
            assertTrue(totals!! === model.result.aggregates)
            assertEquals(GridPagination.Page(1L, 2L), model.query.pagination)
            total("Amount · 总和：10")
        }
        case 6 -> {
            assertTrue(totals!! === model.result.aggregates)
            assertEquals(GridPagination.Page(0L, 2L), model.query.pagination)
        }
        case 7 -> retry = !focused
        case 9 -> {
            assertEquals(Some(GridAggregateId("sum")), model.aggregation(GridColumnId("amount")))
            assertEquals("bad", editor!!.state.text)
            option = findMenu(root!!, "平均值")
        }
        case 11 -> {
            retry = !focused
            if (!retry) {
                assertEquals(
                    Some(GridAggregateId("sum")),
                    model.aggregation(GridColumnId("amount"))
                )
                assertEquals("bad", editor!!.state.text)
                assertTrue(handle.editError != None)
                assertEquals(0, submissions)
                assertTrue(selector!!.same(named("grid-columns-amount-aggregation")))
                total("Amount · 总和：10")
            }
        }
        case 12 -> {
            assertTrue(handle.isSubmitting)
            assertFalse(selector!!.flag(1))
            assertEquals(1, submissions)
            assertEquals(Some(GridAggregateId("sum")), model.aggregation(GridColumnId("amount")))
        }
        case 13 -> {
            assertTrue(handle.isSubmitting)
            assertFalse(selector!!.flag(1))
            assertEquals(1, submissions)
            assertEquals(Some(GridAggregateId("sum")), model.aggregation(GridColumnId("amount")))
        }
        case 14 -> {
            assertFalse(handle.isSubmitting)
            assertEquals(None, handle.editingCell)
            total("Amount · 总和：16")
            option = findMenu(root!!, "平均值")
        }
        case 16 -> prepareMenu("平均值")
        case 18 -> {
            total("Amount · 平均值：4.0")
            totals = Some(model.result.aggregates)
        }
        case 19 -> {
            assertTrue(totals!! === model.result.aggregates)
            assertTrue(selector!!.same(named("grid-columns-amount-aggregation")))
            assertTrue(selector!!.text(0, Some("Aggregate:Amount")))
            total("Amount|平均值|4.0")
        }
        case 22 -> {
            assertEquals("keep", model.query.quickFilter)
            assertEquals(3L, model.result.totalRows)
            assertEquals(
                Some(GridAggregateId("average")),
                model.aggregation(GridColumnId("amount"))
            )
            assertTrue(named("grid-aggregate-count").text(1, Some("Records:3")))
            total(f"Amount|平均值|${14.0 / 3.0}")
        }
        case 23 -> total("Amount|总和|Failed")
        case 24 -> total("Amount|总和|Empty")
        case 26 -> prepareMenu("计数")
        case 28 -> {
            total("Amount|计数|0")
            summary = Some(named("grid-aggregate-amount"))
        }
        case 30 -> prepareMenu("Disabled")
        case 32 -> {
            assertEquals(None, model.aggregation(GridColumnId("amount")))
            assertFalse(summary!!.flag(0))
        }
        case 34 -> assertFalse(selector!!.flag(0))
        case 36 -> {
            assertFalse(selector!!.same(named("grid-columns-amount-aggregation")))
            selector = Some(named("grid-columns-amount-aggregation"))
        }
        case 37 -> assertFalse(selector!!.flag(1))
        case 38 -> assertTrue(selector!!.flag(1))
        case 40 -> prepareMenu("总和")
        case 41 -> {
            assertFalse(handle.isAttached)
            assertFalse(selector!!.flag(0))
            assertFalse(option!!.flag(0))
        }
        else -> {}
    }
}

internal fun AggregationProbe.completed(tag: Int, result: Int) {
    if (logical)
        return completedTotal(tag, result)
    assertEquals(phase, tag)
    val expected =
        if (phase == 10) {
            when (option) {
                case Some(_) -> 0
                case None -> 1
            }
        } else
            if (phase == 12 || phase == 37)
                0
            else
                1
    assertEquals(expected, result, Some(f"native action at ${phase}"))
    waiting = false
    if (retry) {
        frame!!.requestFrame()
        return
    }
    phase += 1
    when (phase) {
        case 5 -> model.setPage(1L)
        case 6 -> model.toggleSort(GridColumnId("amount"))
        case 7 -> assertTrue(handle.beginEdit(address))
        case 8 -> editor!!.state.replaceAll("bad")
        case 12 -> {
            assertTrue(handle.cancelEdit())
            assertTrue(handle.beginEdit(address))
            editor!!.state.replaceAll("7")
            assertEquals(GridEditAttempt.Pending, handle.commitEdit())
        }
        case 14 -> assertTrue(pending!!.accept(aggregateRows([4L, 7L, 3L, 2L])))
        case 19 -> localized.value = true
        case 23 -> {
            model.setAggregation(GridColumnId("amount"), Some(GridAggregateId("sum")))
            model.replaceData(aggregateRows([Long.MAX_VALUE, Long.MAX_VALUE]))
        }
        case 24 -> model.replaceData(aggregateRows([]))
        case 37 -> enabled.value = false
        case 38 -> enabled.value = true
        case 41 -> {
            ui!!.close()
            waiting = true
            calls!!.post(root!!, phase, 20)
            return
        }
        case 42 -> {
            finished = true
            active!!.requestExit()
            return
        }
        else -> {}
    }
    frame!!.requestFrame()
}
