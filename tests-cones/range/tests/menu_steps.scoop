package scoop.grid.tests.range

import scoop.collections.contains
import scoop.graphics.Point
import scoop.grid.*
import scoop.test.*
import scoop.tests.surface.moveSurfacePointer
import scoop.ui.*
import scoop.ui.component.*

internal fun RangeProbe.postMenus() {
    val actions = [203, 207, 211, 214, 217, 220, 224, 230, 233, 237, 240, 243, 246, 249, 252, 269]
    if (actions.contains(phase))
        calls!!.post(menuItem!!, phase)
    else
        calls!!.post(root!!, phase, 20)
}

internal fun RangeProbe.advanceMenus() {
    when (phase) {
        case 201 -> {
            records = rangeRows()
            selected.value = small()
            scroll.scrollTo(Point(0.0, 0.0))
            assertTrue(outside.requestFocus())
        }
        case 202 -> contextClick()
        case 205 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 206 -> key(109, shift = true)
        case 209 -> {
            model.setCellRange(Some(GridCellRange(rangeAddress(2L), rangeAddress(3L, 1L))))
            assertTrue(handle.focusCell(rangeAddress(3L, 1L)))
        }
        case 210 -> key(109, shift = true)
        case 213 -> contextClick()
        case 216 -> contextClick()
        case 219 -> contextClick()
        case 222 -> assertTrue(handle.focusCell(rangeAddress(3L, 1L)))
        case 223 -> key(109, shift = true)
        case 226 -> {
            editor!!.state.replaceAll("bad")
            pointer = Point(180.0, 16.0)
            contextClick()
        }
        case 227 -> {
            editor!!.state.replaceAll("9")
            contextClick()
        }
        case 228 -> {
            records = pendingRows!!
            assertTrue(pending!!.accept(records))
        }
        case 229 -> contextClick()
        case 232 -> contextClick()
        case 235 -> model.setQuery(
            GridQuery(
                sorting =
                    [
                        GridSort(GridColumnId("c0"), GridSortDirection.Ascending),
                        GridSort(GridColumnId("c1"), GridSortDirection.Ascending)
                    ]
            )
        )
        case 236 -> contextClick()
        case 239 -> contextClick()
        case 242 -> {
            pointer = Point(130.0, 16.0)
            contextClick()
        }
        case 245 -> contextClick()
        case 248 -> contextClick()
        case 251 -> contextClick()
        case 254 -> {
            model.setColumnState(GridColumnState(GridColumnId("c1")))
            menus.value = false
            assertTrue(handle.focusCell(rangeAddress(3L, 1L)))
        }
        case 255 -> key(109, shift = true)
        case 256 -> {
            menus.value = true
            enabled.value = false
        }
        case 257 -> contextClick()
        case 258 -> enabled.value = true
        case 259 -> key(109, shift = true)
        case 260 -> selected.value = small()
        case 261 -> assertTrue(handle.focusCell(rangeAddress(3L, 1L)))
        case 262 -> key(109, shift = true)
        case 263 -> model.replaceData(
            TableRows(
                Array<TableRecord<RangeRecord>>(11L) {
                    index ->
                    val key =
                        if (index < 3L)
                            index
                        else
                            index + 1L
                    TableRecord(ViewKey.Number(key), RangeRecord(key, key))
                }
            )
        )
        case 264 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 265 -> key(109, shift = true)
        case 266 -> key(53)
        case 268 -> contextClick()
        case 271 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 272 -> key(109, shift = true)
        case 273 -> enabled.value = false
        case 274 -> enabled.value = true
        case 275 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 276 -> key(109, shift = true)
        case 277 -> menus.value = false
        case 278 -> menus.value = true
        case 279 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 280 -> key(109, shift = true)
        case 281 -> {
            previousMenuModel = Some(model)
            selected.value = small()
        }
        case 282 -> selected.value = previousMenuModel!!
        case 283 -> assertTrue(handle.focusCell(rangeAddress(4L, 1L)))
        case 284 -> key(109, shift = true)
        case 285 -> {
            ui!!.close()
            assertFalse(handle.clearCellRange())
            rejected(handle.copyCells())
            restoredView = Some(handle.restoreViewState(savedView!!))
            waiting = true
            calls!!.post(root!!, phase, 20)
            return
        }
        case 286 -> {
            finished = true
            application!!.requestExit()
            return
        }
        else -> {}
    }
    frame!!.requestFrame()
}

internal fun RangeProbe.inspectMenus() {
    when (phase) {
        case 201 -> prepareClick(3L, 1L)
        case 202 -> {
            menu("copy")
            if (!retry) {
                assertTrue(menuItem!!.text(0, Some("copy")))
                assertEquals(Some(true), root!!.find("grid-menu-edit")?.flag(1))
            }
        }
        case 204 -> {
            menuApplied(GridMenuTarget.Cell(rangeAddress(3L, 1L)), GridMenuCommand.Copy)
            copiedText("3")
            menuClosed()
            retry = retry || handle.focusedCell != Some(rangeAddress(3L, 1L))
        }
        case 205 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 206 -> menu("copy-headers")
        case 208 -> {
            menuApplied(GridMenuTarget.Cell(rangeAddress(4L, 1L)), GridMenuCommand.CopyWithHeaders)
            copiedText("Value\n4")
            menuClosed()
            retry = retry || handle.focusedCell != Some(rangeAddress(4L, 1L))
        }
        case 209 -> retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
        case 210 -> menu("clear-range")
        case 212 -> {
            assertEquals(None, model.cellRange)
            menuClosed()
            prepareClick(3L, 1L)
        }
        case 213 -> menu("select-row")
        case 215 -> {
            assertTrue(model.isRowSelected(ViewKey.Number(3L)))
            menuClosed()
        }
        case 216 -> menu("pin-top")
        case 218 -> {
            assertTrue(model.pinnedRows.top.contains(ViewKey.Number(3L)))
            menuClosed()
            prepareClick(model.result.rows.indexOfKey(ViewKey.Number(3L))!!, 1L)
        }
        case 219 -> menu("unpin-row")
        case 221 -> {
            assertFalse(model.pinnedRows.top.contains(ViewKey.Number(3L)))
            assertTrue(model.isRowSelected(ViewKey.Number(3L)))
            menuClosed()
        }
        case 222 -> retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
        case 223 -> menu("edit")
        case 225 -> {
            assertEquals(Some(rangeAddress(3L, 1L)), handle.editingCell)
            assertEquals("3", editor!!.state.text)
            menuClosed()
        }
        case 226 -> {
            menuClosed()
            assertEquals(Some(rangeAddress(3L, 1L)), handle.editingCell)
            assertEquals("bad", editor!!.state.text)
            assertTrue(handle.editError != None)
        }
        case 227 -> {
            menuClosed()
            assertTrue(handle.isSubmitting)
        }
        case 228 -> assertEquals(None, handle.editingCell)
        case 229 -> menu("sort-descending")
        case 231 -> {
            assertEquals(1L, model.query.sorting.size)
            assertEquals(
                GridSort(GridColumnId("c1"), GridSortDirection.Descending),
                model.query.sorting[0L]
            )
            menuClosed()
        }
        case 232 -> menu("clear-sort")
        case 234 -> assertEquals(0L, model.query.sorting.size)
        case 236 -> menu("sort-descending")
        case 238 -> {
            assertEquals(2L, model.query.sorting.size)
            assertEquals(
                GridSort(GridColumnId("c0"), GridSortDirection.Ascending),
                model.query.sorting[0L]
            )
            assertEquals(
                GridSort(GridColumnId("c1"), GridSortDirection.Descending),
                model.query.sorting[1L]
            )
        }
        case 239 -> menu("fit-content")
        case 241 -> {
            when (menuResult!!) {
                case Sizing(val request) -> when (request.result) {
                    case Applied(_) -> {}
                    case Pending -> retry = true
                    else -> fail(Some("menu content fit did not apply"))
                }
                else -> fail(Some("menu did not return sizing request"))
            }
            menuClosed()
        }
        case 242 -> menu("reset-width")
        case 244 -> assertEquals(None, model.columnState[1L].width)
        case 245 -> menu("pin-start")
        case 247 -> assertEquals(GridPin.Start, model.columnState[1L].pin)
        case 248 -> menu("unpin-column")
        case 250 -> assertEquals(GridPin.None, model.columnState[1L].pin)
        case 251 -> menu("hide-column")
        case 253 -> {
            assertFalse(model.columnState[1L].visible)
            menuClosed()
        }
        case 254 -> retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
        case 255 -> menuClosed()
        case 257 -> menuClosed()
        case 258 -> retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
        case 259 -> menu("copy")
        case 260 -> menuClosed()
        case 261 -> retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
        case 262 -> menu("copy")
        case 263 -> menuClosed()
        case 264 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 265 -> menu("copy")
        case 266 -> menuClosed()
        case 267 -> prepareClick(model.result.rows.indexOfKey(ViewKey.Number(4L))!!, 2L)
        case 268 -> {
            menuItem =
                Some(
                    keep(
                        root!!.find("range-cell-menu-action") ?:
                            fail(Some("cell content must own its context menu"))
                    )
                )
            assertEquals(None, root!!.find("grid-menu-pin-top")?.flag(0))
        }
        case 270 -> {
            assertEquals(1, innerMenuClicks)
            menuClosed()
        }
        case 271 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 272 -> menu("copy")
        case 273 -> menuClosed()
        case 274 -> menuClosed()
        case 275 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 276 -> menu("copy")
        case 277 -> menuClosed()
        case 278 -> menuClosed()
        case 279 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 280 -> menu("copy")
        case 281 -> menuClosed()
        case 282 -> menuClosed()
        case 283 -> retry = handle.focusedCell != Some(rangeAddress(4L, 1L))
        case 284 -> menu("copy")
        case 285 -> {
            assertFalse(handle.isAttached)
            assertFalse(node!!.flag(0))
            assertFalse(findField!!.flag(0))
            assertFalse(statisticsButton!!.flag(0))
            assertFalse(statisticsValues!!.flag(0))
            assertFalse(menuItem!!.flag(0))
            assertEquals(None, handle.saveViewState()?.focusedCell ?: None)
            when (restoredView!!) {
                case Rejected(_) -> {}
                else -> fail(Some("unmounted restore must reject"))
            }
        }
        else -> {}
    }
}

private fun RangeProbe.menu(id: String) {
    val item = root!!.find(f"grid-menu-${id}")
    when (item) {
        case None -> {
            retry = true
            return
        }
        case Some(val node) -> menuItem = Some(keep(node))
    }
    assertTrue(menuItem!!.flag(1))
}

private fun RangeProbe.menuClosed() {
    retry =
        retry ||
            (root!!.find("grid-menu-copy")?.flag(0) ?: false) ||
            (root!!.find("grid-menu-sort-ascending")?.flag(0) ?: false)
    when (menuItem) {
        case Some(val item) -> retry = retry || item.flag(0)
        case None -> {}
    }
}

private fun RangeProbe.menuApplied(target: GridMenuTarget, command: GridMenuCommand) {
    assertEquals(Some(target), menuTarget)
    assertEquals(Some(command), menuCommand)
    when (menuResult!!) {
        case Applied -> {}
        case Rejected(val message) -> fail(Some(message))
        else -> fail(Some("unexpected menu result"))
    }
}

private fun RangeProbe.contextClick() {
    assertTrue(moveSurfacePointer(window!!, pointer.x, pointer.y))
    @Unsafe
    {
        assertTrue(nativeContextClick(view!!, pointer.x, pointer.y))
    }
    inputQueued()
}

@Extern(name = "scoop_grid_range_context_click")
private fun nativeContextClick(view: Ptr<Unit>, x: Double, y: Double): Boolean
