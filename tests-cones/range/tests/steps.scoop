package scoop.grid.tests.range

import scoop.graphics.Point
import scoop.grid.*
import scoop.test.*
import scoop.tests.ui.accessibility.native.*
import scoop.ui.*
import scoop.window.*

internal fun RangeProbe.accepted() {
    acceptedFrames += 1
    windowFocused = window?.isFocused ?: false
    if (finished || waiting || waitingInput || !windowFocused)
        return
    when (calls) {
        case None -> return;
        case Some(_) -> {}
    }
    if (!initialized) {
        initialized = true
        assertTrue(outside.requestFocus())
    }
    if (phase == 2 && !handle.isPending && handle.focusedCell != Some(rangeAddress(0L)))
        assertTrue(handle.focusCell(rangeAddress(0L)))
    if (phase == 20 && !handle.isPending && handle.focusedCell != Some(rangeAddress(2L, 1L)))
        assertTrue(handle.focusCell(rangeAddress(2L, 1L)))
    waiting = true
    retry = false
    if (phase >= 123) {
        postFind()
        return
    }
    calls!!.post(root!!, phase, 20)
}

internal fun RangeProbe.inspect(tag: Int) {
    assertEquals(phase, tag)
    if (phase >= 123) {
        inspectFind()
        return
    }
    if (phase >= 43) {
        inspectDrag()
        return
    }
    when (phase) {
        case 0 -> {
            table = Some(findTable(root!!) ?: fail(Some("native table is missing")))
            far = Some(cell(50000000L, 37L))
            assertEquals(0L, far!!.trait(0))
            assertEquals(None, model.cellRange)
        }
        case 1 -> {
            selectedRange(rangeAddress(50000000L, 37L), rangeAddress(50000001L, 39L))
            assertEquals(1L, far!!.trait(0))
            copiedText(
                "R50000000C37\tR50000000C38\tR50000000C39\nR50000001C37\tR50000001C38\tR50000001C39"
            )
            assertEquals(Point(0.0, 0.0), scroll.offset)
            assertTrue(outside.hasFocus)
            assertFalse(live.contains(rangeAddress(50000000L, 37L)))
            assertTrue(reads < 500L)
            assertTrue(live.size < 250L)
        }
        case 2 -> {
            assertFalse(far!!.flag(0))
            retry = handle.focusedCell != Some(rangeAddress(0L))
        }
        case 3 -> {
            selectedRange(rangeAddress(0L), rangeAddress(0L, 1L))
            assertEquals(None, handle.editingCell)
            retry = handle.focusedCell != Some(rangeAddress(0L, 1L))
        }
        case 4 -> {
            assertEquals(None, handle.editingCell)
            selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
            assertEquals(1L, cell(0L, 0L).trait(0))
            assertEquals(1L, cell(1L, 1L).trait(0))
            assertEquals(0L, cell(2L, 1L).trait(0))
            retry = handle.focusedCell != Some(rangeAddress(1L, 1L))
        }
        case 5 -> {
            assertEquals(2, copies)
            copiedOk(lastCopy!!)
            copiedText("R0C0\t0\nR1C0\t1")
        }
        case 6 -> {
            selectedRange(rangeAddress(0L), rangeAddress(1L, 79L))
            assertEquals(1L, cell(1L, 40L).trait(0))
            assertFalse(live.contains(rangeAddress(1L, 40L)))
            retry = handle.focusedCell != Some(rangeAddress(1L, 79L))
        }
        case 7 -> {
            assertEquals(3, copies)
            copiedOk(lastCopy!!)
            assertEquals(model.copyText(), window!!.clipboard.readText())
        }
        case 8 -> {
            assertEquals(None, model.cellRange)
            retry = handle.focusedCell != Some(rangeAddress(2L, 79L))
        }
        case 9 -> {
            selectedRange(rangeAddress(2L, 79L), rangeAddress(2L))
            retry = handle.focusedCell != Some(rangeAddress(2L))
        }
        case 10 -> {
            assertEquals(None, model.cellRange);
            prepareClick(3L, 1L)
        }
        case 11 -> {
            selectedRange(rangeAddress(2L), rangeAddress(3L, 1L))
            retry = handle.focusedCell != Some(rangeAddress(3L, 1L))
            prepareClick(4L, 1L)
        }
        case 12 -> {
            selectedRange(rangeAddress(4L, 1L), rangeAddress(4L, 1L))
            prepareClick(4L, 2L)
        }
        case 13 -> {
            assertEquals(1, clicks)
            selectedRange(rangeAddress(4L, 1L), rangeAddress(4L, 1L))
            assertEquals(beforeCopies, copies)
        }
        case 14 -> {
            assertEquals(beforeCopies, copies);
            assertEquals(None, handle.editingCell)
        }
        case 15 -> {
            assertEquals(Some(rangeAddress(4L, 1L)), handle.editingCell)
            selectedRange(rangeAddress(4L, 1L), rangeAddress(4L, 1L))
        }
        case 16 -> {
            copiedText("4");
            assertEquals(beforeCopies, copies)
        }
        case 17 -> {
            selectedRange(rangeAddress(4L, 1L), rangeAddress(4L, 1L))
            assertEquals(Some(rangeAddress(4L, 1L)), handle.editingCell)
        }
        case 18 -> assertEquals(None, handle.editingCell)
        case 19 -> {
            copiedText("4")
            assertFalse(cell(4L, 1L).flag(1))
            selectedRange(rangeAddress(4L, 1L), rangeAddress(4L, 1L))
        }
        case 20 -> retry = handle.focusedCell != Some(rangeAddress(2L, 1L))
        case 21 -> {
            selectedRange(rangeAddress(2L, 1L), rangeAddress(2L, 2L))
            retry = handle.focusedCell != Some(rangeAddress(2L, 2L))
        }
        case 22 -> {
            selectedRange(rangeAddress(2L, 1L), rangeAddress(2L, 1L))
            retry = handle.focusedCell != Some(rangeAddress(2L, 1L))
        }
        case 23 -> {
            assertEquals(None, model.cellRange)
            retry = handle.focusedCell != Some(rangeAddress(2L, 79L))
            prepareClick(3L, 0L)
        }
        case 24 -> {
            selectedRange(rangeAddress(2L, 79L), rangeAddress(3L))
            assertEquals(1L, cell(2L, 0L).trait(0))
            assertEquals(1L, cell(3L, 79L).trait(0))
        }
        case 25 -> selectedRange(rangeAddress(2L, 79L), rangeAddress(3L))
        case 26 -> assertEquals(None, model.cellRange)
        case 27 -> {
            assertEquals(5, copies)
            copiedOk(lastCopy!!)
            copiedText("R3C0")
        }
        case 28 -> assertEquals(None, model.cellRange)
        case 29 -> {
            selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
            copiedText("R100C0\t100\nR101C0\t101")
        }
        case 30 -> assertEquals(None, model.cellRange)
        case 31 -> {
            assertEquals(Some(rangeAddress(0L, 1L)), handle.editingCell)
            prepareClick(3L, 1L)
        }
        case 32 -> {
            assertEquals(Some(rangeAddress(0L, 1L)), handle.editingCell)
            assertTrue(handle.editError != None)
            assertEquals(0, submissions)
            selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
            prepareClick(3L, 1L)
        }
        case 33 -> {
            assertTrue(handle.isSubmitting)
            assertEquals(1, submissions)
            selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
        }
        case 34 -> {
            assertEquals(None, handle.editingCell)
            selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
            prepareClick(3L, 1L)
        }
        case 35 -> {
            selectedRange(rangeAddress(3L, 1L), rangeAddress(3L, 1L))
            assertEquals(1, submissions)
        }
        case 36 -> {
            copiedText("R101C4\tR101C5")
            node = Some(cell(1L, 4L))
            assertTrue(node!!.same(cell(1L, 5L)))
            assertEquals(1L, node!!.trait(0))
        }
        case 37 -> copiedText("preserve")
        case 38 -> copiedText("")
        case 39 -> {
            assertEquals(None, handle.cellRange);
            assertTrue(outside.hasFocus)
        }
        case 40 -> {
            copiedText("Column 0\tValue\nR0C0\t0\nR1C0\t1")
            assertTrue(outside.hasFocus)
            node = Some(cell(0L, 0L))
        }
        case 41 -> selectedRange(rangeAddress(0L), rangeAddress(1L, 1L))
        case 42 -> assertTrue(handle.isAttached)
        else -> fail(Some("unexpected range phase"))
    }
}

internal fun RangeProbe.completed(tag: Int, result: Int) {
    assertEquals(phase, tag)
    assertEquals(1, result)
    waiting = false
    if (retry) {
        frame!!.requestFrame();
        return
    }
    phase += 1
    if (phase >= 123) {
        advanceFind()
        return
    }
    if (phase >= 43) {
        advanceDrag()
        return
    }
    when (phase) {
        case 1 -> {
            assertTrue(
                handle.setCellRange(
                    Some(GridCellRange(rangeAddress(50000000L, 37L), rangeAddress(50000001L, 39L)))
                )
            )
            before = built
            copiedOk(handle.copyCells())
            assertEquals(before, built)
        }
        case 2 -> selected.value = small()
        case 3 -> key(124, shift = true)
        case 4 -> key(125, shift = true)
        case 5 -> key(8, primary = true)
        case 6 -> key(119, shift = true)
        case 7 -> menuCopy()
        case 8 -> key(125)
        case 9 -> key(115, shift = true)
        case 10 -> key(53)
        case 11 -> click(true)
        case 12 -> click()
        case 13 -> {
            beforeCopies = copies;
            click()
        }
        case 14 -> key(8, primary = true)
        case 15 -> assertTrue(handle.beginEdit(rangeAddress(4L, 1L)))
        case 16 -> {
            key(0, primary = true);
            key(8, primary = true)
        }
        case 17 -> key(123, shift = true)
        case 18 -> key(53)
        case 19 -> enabled.value = false
        case 20 -> {
            rejected(handle.copyCells())
            assertFalse(handle.clearCellRange())
            enabled.value = true
            direction.value = LayoutDirection.Rtl
            model.clearCellRange()
        }
        case 21 -> key(123, shift = true)
        case 22 -> key(124, shift = true)
        case 23 -> key(119)
        case 24 -> click(true)
        case 25 -> model.setColumnState(GridColumnState(GridColumnId("c1"), width = Some(140.0)))
        case 26 -> model.setColumnState(GridColumnState(GridColumnId("c4"), visible = false))
        case 27 -> key(8, primary = true)
        case 28 -> {
            assertTrue(
                model.setCellRange(Some(GridCellRange(rangeAddress(0L), rangeAddress(1L, 1L))))
            )
            model.toggleSort(GridColumnId("c1"))
        }
        case 29 -> {
            model.setQuery(GridQuery())
            assertTrue(
                model.setCellRange(Some(GridCellRange(rangeAddress(0L), rangeAddress(1L, 1L))))
            )
            records = rangeRows(100L)
            model.replaceData(records)
            copiedOk(handle.copyCells())
        }
        case 30 -> model.setPagination(GridPagination.Page(0L, 5L))
        case 31 -> {
            assertTrue(
                handle.setCellRange(Some(GridCellRange(rangeAddress(0L), rangeAddress(1L, 1L))))
            )
            assertTrue(handle.beginEdit(rangeAddress(0L, 1L)))
            editor!!.state.replaceAll("bad")
        }
        case 32 -> click()
        case 33 -> {
            editor!!.state.replaceAll("150");
            click()
        }
        case 34 -> {
            records = pendingRows!!;
            assertTrue(pending!!.accept(records))
        }
        case 35 -> click()
        case 36 -> {
            model.setColumnState(GridColumnState(GridColumnId("c4")))
            spans.value = true
            assertTrue(
                handle.setCellRange(Some(GridCellRange(rangeAddress(1L, 4L), rangeAddress(1L, 5L))))
            )
            copiedOk(handle.copyCells())
        }
        case 37 -> {
            window!!.clipboard.writeText("preserve")
            failCopy = true
            rejected(handle.copyCells())
            failCopy = false
        }
        case 38 -> {
            assertTrue(handle.clearCellRange())
            copiedOk(handle.copyCells(Some(rangeAddress(0L, 2L))))
        }
        case 39 -> {
            records = rangeRows()
            selected.value = small()
            spans.value = false
            assertTrue(outside.requestFocus())
        }
        case 40 -> {
            assertTrue(
                handle.setCellRange(Some(GridCellRange(rangeAddress(0L), rangeAddress(1L, 1L))))
            )
            copiedOk(handle.copyCells(includeHeaders = true))
        }
        case 41 -> enabled.value = false
        case 42 -> {
            assertFalse(handle.clearCellRange())
            rejected(handle.copyCells())
            enabled.value = true
        }
        else -> {}
    }
    frame!!.requestFrame()
}
