package scoop.grid.examples.demo

import scoop.ui.ViewKey
import scoop.ui.component.*

internal struct Quote(
    val ticker: String,
    val name: String,
    val instrument: String,
    val quantity: Long,
    val purchase: Long,
    val price: Long,
    val previous: Long
) {
    val value: Long get() = quantity * price
    val profit: Long get() = quantity * (price - purchase)
    val change: Long get() = (price - previous) * 10000L / previous
    fun refreshed(sequence: Long, index: Long): Quote {
        val direction = (sequence * 7L + index * 11L) % 13L - 6L
        val delta = price * direction / 1000L
        return Quote(
            ticker,
            name,
            instrument,
            quantity,
            purchase,
            price +
                if (delta == 0L)
                    1L
                else
                    delta,
            price
        )
    }
}

