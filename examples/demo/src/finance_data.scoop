internal fun quoteRows(quotes: Array<Quote>): TableRows<Quote> =
    TableRows(
        Array<TableRecord<Quote>>(quotes.size) {
            TableRecord(ViewKey.Text(quotes[it].ticker), quotes[it])
        }
    )
