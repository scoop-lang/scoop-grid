package scoop.grid

/** Localizable presentation for filter drafts; query and candidate keys remain typed. */
public class GridFilterLabels public constructor(
    public val apply: String = "应用筛选",
    public val applyName: String = "应用筛选",
    public val revert: String = "还原草稿",
    public val revertName: String = "还原筛选草稿",
    public val clear: String = "清除筛选",
    public val clearName: String = "清除筛选",
    public val name: String = "筛选条件",
    public val allConditions: String = "所有条件（AND）",
    public val anyCondition: String = "任一条件（OR）",
    public val groupTitle: (String) -> String = { path -> f"条件组 ${path}" },
    public val conditionTitle: (String, String) -> String =
        { path, column -> f"条件 ${path} ${column}" },
    public val joinName: (String) -> String = { title -> f"${title} 组合方式" },
    public val removeGroup: String = "删除组",
    public val removeGroupName: (String) -> String = { title -> f"删除${title}" },
    public val emptyRoot: String = "尚未添加条件",
    public val emptyGroup: String = "请添加条件或删除该组",
    public val allRecords: String = "所有记录",
    public val removeCondition: String = "删除",
    public val removeConditionName: (String) -> String = { path -> f"删除条件 ${path}" },
    public val addCondition: String = "添加条件",
    public val addConditionName: (String) -> String = { title -> f"${title} 添加条件" },
    public val addGroup: String = "添加条件组",
    public val addGroupName: (String) -> String = { title -> f"${title} 添加条件组" },
    public val unavailableColumn: String = "列已不可用",
    public val unavailableColumnHelp: String = "此列已不可用，请选择另一列或删除条件",
    public val columnName: (String) -> String = { title -> f"${title} 筛选列" },
    public val operatorName: (String) -> String = { title -> f"${title} 筛选方式" },
    public val lowerName: (String) -> String = { title -> f"${title} 下限" },
    public val upperName: (String) -> String = { title -> f"${title} 上限" },
    public val valueName: (String) -> String = { title -> f"${title} 筛选值" },
    public val betweenSeparator: String = "至",
    public val caseSensitive: String = "区分大小写",
    public val caseName: (String) -> String = { title -> f"${title} 区分大小写" },
    public val yes: String = "是",
    public val no: String = "否",
    public val calendarName: (String) -> String = { title -> f"${title} 日历" },
    public val datePlaceholder: String = "YYYY-MM-DD",
    public val integerPlaceholder: String = "整数",
    public val numberPlaceholder: String = "数值",
    public val textPlaceholder: String = "文字",
    public val equal: String = "等于",
    public val notEqual: String = "不等于",
    public val less: String = "小于",
    public val lessOrEqual: String = "小于或等于",
    public val greater: String = "大于",
    public val greaterOrEqual: String = "大于或等于",
    public val between: String = "闭区间",
    public val contains: String = "包含",
    public val startsWith: String = "开头是",
    public val endsWith: String = "结尾是",
    public val missing: String = "缺值",
    public val present: String = "非缺值",
    public val inSet: String = "属于集合",
    public val loadCandidates: String = "加载候选",
    public val reloadCandidates: String = "重新加载",
    public val loadName: (String) -> String = { title -> f"${title} 加载候选" },
    public val selectShown: String = "选中当前列表",
    public val selectShownName: (String) -> String = { title -> f"${title} 选中当前列表" },
    public val clearSelection: String = "清空选择",
    public val clearSelectionName: (String) -> String = { title -> f"${title} 清空选择" },
    public val searchPlaceholder: String = "查找候选",
    public val searchName: (String) -> String = { title -> f"${title} 查找候选" },
    public val search: String = "查找",
    public val searchApplyName: (String) -> String = { title -> f"${title} 查找" },
    public val unloadedStatus: (Long) -> String = { count -> f"已选 ${count} 项；点击加载候选" },
    public val loadedStatus: (Long, Long) -> String =
        { count, shown -> f"已选 ${count} 项 · 当前列表 ${shown} 项" },
    public val staleCandidates: String = "候选已过期，请重新加载；已选值仍保留",
    public val emptyCandidates: String = "没有匹配的候选",
    public val candidatesName: (String) -> String = { title -> f"${title} 集合候选" },
    public val missingValue: String = "（缺值）",
    public val emptyText: String = "（空字符串）",
    public val invalidFilter: String = "筛选条件无效",
    public val finishEditing: String = "请先处理当前单元格的编辑，再应用筛选",
    public val invalidInteger: String = "请输入有效整数",
    public val invalidNumber: String = "请输入有效数值",
    public val nonfiniteNumber: String = "请输入有限数值",
    public val invalidDate: String = "请输入有效日期（YYYY-MM-DD）",
    public val emptyNestedGroup: String = "请为嵌套条件组添加条件，或删除该组",
    public val loadFailed: String = "无法加载候选",
    public val columnRemoved: (String) -> String = { id -> f"筛选列已移除：${id}" },
    public val columnUnfilterable: (String) -> String = { title -> f"列不可筛选：${title}" },
    public val columnWithoutValue: (String) -> String = { title -> f"列没有可筛选的值：${title}" },
    public val error: (String) -> String = { message -> message }
)
