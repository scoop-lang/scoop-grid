package scoop.grid

import scoop.collections.HashSet
import scoop.graphics.text.FontCollection
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.ui.component.pagination as queryPagination
import scoop.ui.component.select as querySelect
import scoop.ui.component.row as queryRow

public class GridPagerProps<Row> public constructor(
    public val state: DataGridState<Row>,
    public val pageSizes: Array<Long> = [25L, 50L, 100L],
    public val handle: DataGridHandle? = None,
    public val enabled: Boolean = true,
    public val fonts: FontCollection? = None,
    public val theme: ThemeSource? = None,
    public val labels: GridPagerLabels = GridPagerLabels()
) {
    init {
        val sizes = HashSet<Long>()
        for (size in pageSizes)
            gridRequire(size > 0L && sizes.add(size), "grid page sizes must be positive and unique")
    }
}

public class GridPager<Row> public constructor(
    private val props: Props<GridPagerProps<Row>>,
    scope: ComponentScope
): Component(scope) {
    private var ambient: ThemeSource? = None
    public override fun onMount() {
        when (props.value.theme) {
            case None -> ambient = Some(currentThemeSource())
            case Some(_) -> {}
        }
    }
    private fun ready(input: GridPagerProps<Row>): Boolean =
        scope.isMounted &&
            input.enabled &&
            gridQueryReady(input.handle) &&
            scope.isMounted &&
            props.value.state ===
            input.state

    private fun page(): Long =
        when (props.value.state.query.pagination) {
            case Page(val index, _) -> index + 1L
            case Disabled -> 1L
        }

    private fun selectPage(value: Long) {
        val input = props.value
        if (!ready(input))
            return
        when (input.state.query.pagination) {
            case Page(_, _) -> input.state.setPage(value - 1L)
            case Disabled -> {}
        }
    }

    private fun selectSize(value: GridPagination?) {
        val next = value ?: return
        val input = props.value
        if (ready(input))
            input.state.setPagination(next)
    }

    public override fun render(): View {
        val input = props.value
        val labels = input.labels
        val source = input.theme ?: (ambient ?: currentThemeSource())
        val appearance =
            GridAppearance(
                source.read(scope),
                input.fonts ?: scope.defaultFonts,
                scope.layoutDirection
            )
        val model = input.state
        val query = model.query
        val result = model.result
        val available = input.enabled && !(input.handle?.isSubmitting ?: false)
        val choices = ArrayList<Choice<GridPagination>>()
        choices.add(Choice(ViewKey.Text("all"), GridPagination.Disabled, labels.all))
        var listed = false
        for (size in input.pageSizes) {
            val choice = GridPagination.Page(0L, size)
            choices.add(Choice(ViewKey.Number(size), choice, labels.size(size)))
            if (gridFirstPage(query.pagination) == choice)
                listed = true
        }
        if (!listed)
            when (query.pagination) {
                case Page(_, val size) -> choices.add(
                    Choice(ViewKey.Number(size), GridPagination.Page(0L, size), labels.size(size))
                )
                case Disabled -> {}
            }
        val status =
            if (query.pagination == GridPagination.Disabled || result.pageCount == 0L)
                labels.rows(result.totalRows)
            else
                labels.status(result.totalRows, page(), result.pageCount)
        return column {
            add(
                queryRow {
                    item(appearance.label(status)) { grow = 1.0 }
                    add(
                        querySelect(
                            binding<GridPagination?>(
                                {
                                    Some(
                                        gridFirstPage(
                                            this @GridPager.props.value.state.query.pagination
                                        )
                                    )
                                },
                                { value -> this @GridPager.selectSize(value) }
                            ),
                            choices.toArray()
                        ) {
                            enabled = available
                            fonts = input.fonts
                            theme = input.theme
                            width = Some(128.0 * appearance.density)
                            semantics =
                                ComponentSemantics(
                                    name = Some(labels.sizeName),
                                    automationId = Some("grid-page-size")
                                )
                        }
                    )
                    spacing = 8.0 * appearance.density
                    alignment = CrossAlignment.Center
                }
            )
            if (query.pagination != GridPagination.Disabled)
                add(
                    queryPagination(
                        binding(
                            { this @GridPager.page() },
                            { value -> this @GridPager.selectPage(value) }
                        ),
                        result.pageCount
                    ) {
                        enabled = available
                        compact = true
                        items =
                            Some(
                                if (result.pageCount == 0L)
                                    []
                                else
                                    [PaginationItem.Page(this @GridPager.page())]
                            )
                        previousText = labels.previous
                        nextText = labels.next
                        pageLabel = labels.page
                        fonts = input.fonts
                        theme = input.theme
                        semantics =
                            ComponentSemantics(
                                name = Some(labels.name),
                                automationId = Some("grid-pagination")
                            )
                    }
                )
            spacing = 4.0 * appearance.density
            alignment = CrossAlignment.Stretch
        }
    }
}

public class GridPagerBuilder internal constructor() {
    public var pageSizes: Array<Long> = [25L, 50L, 100L]
    public var handle: DataGridHandle? = None
    public var enabled: Boolean = true
    public var fonts: FontCollection? = None
    public var theme: ThemeSource? = None
    public var labels: GridPagerLabels = GridPagerLabels()
    public var key: ViewKey = ViewKey.Position
    internal fun <Row> snapshot(state: DataGridState<Row>): GridPagerProps<Row> =
        GridPagerProps(state, pageSizes, handle, enabled, fonts, theme, labels)
}

public fun <Row> gridPager(
    state: DataGridState<Row>,
    configure: GridPagerBuilder.() -> Unit = {}
): View {
    val builder = GridPagerBuilder()
    builder.configure()
    return component(
        builder.snapshot(state),
        { current, mount -> GridPager(current, mount) },
        builder.key
    )
}
