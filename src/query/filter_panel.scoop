package scoop.grid

import scoop.datetime.*
import scoop.graphics.text.FontCollection
import scoop.platform.time.SystemClock
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.ui.component.button as filterButton
import scoop.ui.component.scrollArea as filterScroll

public class GridFilterPanelProps<Row> public constructor(
    public val state: DataGridState<Row>,
    public val handle: DataGridHandle? = None,
    public val height: Double = 320.0,
    public val candidatesHeight: Double = 160.0,
    public val referenceDate: LocalDate? = None,
    public val enabled: Boolean = true,
    public val fonts: FontCollection? = None,
    public val theme: ThemeSource? = None,
    public val labels: GridFilterLabels = GridFilterLabels()
) {
    init {
        gridRequire(
            height.isFinite() && height > 0.0,
            "filter panel height must be positive and finite"
        )
        gridRequire(
            candidatesHeight.isFinite() && candidatesHeight > 0.0,
            "candidate list height must be positive and finite"
        )
    }
}

public class GridFilterPanel<Row> public constructor(
    private val props: Props<GridFilterPanelProps<Row>>,
    scope: ComponentScope
): Component(scope) {
    private val keys = GridFilterKeys()
    private var model = props.value.state
    private var applied = model.query.filter
    private var draft = GridFilterDraft(applied, keys)
    private val revision = state(0L)
    private var message: String? = None
    private val defaultDate =
        props.value.referenceDate ?: SystemClock.now().toLocalDateTime(UtcOffset.ZERO).date
    private var ambient: ThemeSource? = None

    public override fun onMount() {
        when (props.value.theme) {
            case None -> ambient = Some(currentThemeSource())
            case Some(_) -> {}
        }
    }
    private fun report(text: String) {
        if (scope.isMounted) {
            message = Some(text)
            revision.value += 1L
        }
    }
    private fun revert() {
        if (!scope.isMounted || !props.value.enabled || draft.composing)
            return
        model = props.value.state
        applied = model.query.filter
        draft = GridFilterDraft(applied, keys)
        message = None
        revision.value += 1L
    }
    private fun apply(clear: Boolean = false) {
        if (!scope.isMounted || !props.value.enabled || draft.composing)
            return
        val input = props.value
        val filter =
            try {
                if (clear)
                    GridFilter.All
                else
                    draft.filter(
                        { id -> gridFilterKind(input.state, id, input.labels) },
                        input.labels
                    )
            } catch (error: IllegalArgumentException) {
                report(error.message ?: input.labels.invalidFilter)
                return
            }
        if (!gridQueryReady(input.handle)) {
            report(input.labels.finishEditing)
            return
        }
        if (!scope.isMounted || props.value.state !== input.state)
            return
        val before = input.state.result
        val query = input.state.query
        try {
            input.state.setQuery(query.withFilter(filter))
        } catch (error: IllegalArgumentException) {
            if (input.state.result !== before)
                throw error
            report(error.message ?: input.labels.invalidFilter)
            return
        }
        if (!scope.isMounted)
            return
        applied = input.state.query.filter
        if (clear || applied != filter)
            draft = GridFilterDraft(applied, keys)
        message = None
        revision.value += 1L
    }
    public override fun render(): View {
        revision.value
        val input = props.value
        val labels = input.labels
        val current = input.state.query.filter
        if (model !== input.state || current != applied) {
            model = input.state
            applied = current
            draft = GridFilterDraft(current, keys)
            message = None
        }
        val source = input.theme ?: (ambient ?: currentThemeSource())
        val appearance =
            GridAppearance(
                source.read(scope),
                input.fonts ?: scope.defaultFonts,
                scope.layoutDirection
            )
        val currentDraft = draft
        val ui =
            GridFilterUi(
                input,
                currentDraft,
                appearance,
                input.referenceDate ?: defaultDate,
                {
                    scope.isMounted &&
                        props.value.enabled &&
                        props.value.state ===
                        input.state &&
                        draft ===
                        currentDraft
                },
                { text -> report(text) }
            )
        val available = input.enabled && !draft.composing && !(input.handle?.isSubmitting ?: false)
        return column {
            row {
                add(
                    filterButton(labels.apply, { this @GridFilterPanel.apply() }) {
                        enabled = available
                        fonts = input.fonts
                        theme = input.theme
                        semantics =
                            ComponentSemantics(
                                name = Some(labels.applyName),
                                automationId = Some("grid-filter-apply")
                            )
                    }
                )
                add(
                    filterButton(labels.revert, { this @GridFilterPanel.revert() }) {
                        enabled = input.enabled && !currentDraft.composing
                        variant = ButtonVariant.Outline
                        fonts = input.fonts
                        theme = input.theme
                        semantics =
                            ComponentSemantics(
                                name = Some(labels.revertName),
                                automationId = Some("grid-filter-revert")
                            )
                    }
                )
                add(
                    filterButton(labels.clear, { this @GridFilterPanel.apply(true) }) {
                        enabled = available
                        variant = ButtonVariant.Outline
                        fonts = input.fonts
                        theme = input.theme
                        semantics =
                            ComponentSemantics(
                                name = Some(labels.clearName),
                                automationId = Some("grid-filter-clear")
                            )
                    }
                )
                spacing = 8.0 * appearance.density
                alignment = CrossAlignment.Center
            }
            when (this @GridFilterPanel.message) {
                case Some(val text) -> add(ui.message(labels.error(text)))
                case None -> {}
            }
            add(
                filterScroll(gridFilterGroupView(currentDraft.root, ui, "", None)) {
                    key = ViewKey.Text("grid-filter-body")
                    height = Some(input.height * appearance.density)
                    theme = input.theme
                    enabled = input.enabled
                    semantics =
                        ComponentSemantics(
                            name = Some(labels.name),
                            automationId = Some("grid-filter-tree")
                        )
                }
            )
            spacing = 8.0 * appearance.density
            alignment = CrossAlignment.Stretch
        }
    }
}

public class GridFilterPanelBuilder internal constructor() {
    public var handle: DataGridHandle? = None
    public var height: Double = 320.0
    public var candidatesHeight: Double = 160.0
    public var referenceDate: LocalDate? = None
    public var enabled: Boolean = true
    public var fonts: FontCollection? = None
    public var theme: ThemeSource? = None
    public var labels: GridFilterLabels = GridFilterLabels()
    public var key: ViewKey = ViewKey.Position
    internal fun <Row> snapshot(state: DataGridState<Row>): GridFilterPanelProps<Row> =
        GridFilterPanelProps(
            state,
            handle,
            height,
            candidatesHeight,
            referenceDate,
            enabled,
            fonts,
            theme,
            labels
        )
}

public fun <Row> gridFilterPanel(
    state: DataGridState<Row>,
    configure: GridFilterPanelBuilder.() -> Unit = {}
): View {
    val builder = GridFilterPanelBuilder()
    builder.configure()
    return component(
        builder.snapshot(state),
        { current, mount -> GridFilterPanel(current, mount) },
        builder.key
    )
}
