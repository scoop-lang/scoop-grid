package scoop.grid

import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.surface.*
import scoop.ui.*
import scoop.window.*
import scoop.window.accessibility.*

internal class GridCellClip(
    val bounds: Rect,
    val region: Rect,
    val axes: ScrollAxes,
    val viewport: ScrollViewport
)

internal class GridRowCells<Row>(
    private val row: Row,
    private val rowKey: ViewKey,
    private val rowIndex: Long,
    private val columns: GridColumnsPlan<Row>,
    private val session: GridSession<Row>
): ItemSource {
    public override val count: Long get() = columns.columns.size
    public override fun keyAt(index: Long): ViewKey = ViewKey.Text(columns.columns[index].id.value)
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Text(val value) -> if (value == "")
                None
            else
                columns.indexOf(GridColumnId(value))
            else -> None
        }
    public override fun build(index: Long): View {
        val column = columns.columns[index]
        return component(
            GridDataCellProps(row, rowKey, rowIndex, index, column, columns.appearance, session),
            { props, scope -> GridDataCell(props, scope) }
        )
    }
}

internal class GridHeaderCells<Row>(
    private val columns: GridColumnsPlan<Row>,
    private val model: DataGridState<Row>,
    private val session: GridSession<Row>,
    private val modifier: GridMultiSortModifier
): ItemSource {
    public override val count: Long get() = columns.columns.size
    public override fun keyAt(index: Long): ViewKey = ViewKey.Text(columns.columns[index].id.value)
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Text(val value) -> if (value == "")
                None
            else
                columns.indexOf(GridColumnId(value))
            else -> None
        }
    public override fun build(index: Long): View {
        val column = columns.columns[index]
        var title = column.title
        val sorting = model.query.sorting
        for (priority in 0L ..< sorting.size) {
            val sort = sorting[priority]
            if (sort.column == column.id) {
                title += if (sort.direction == GridSortDirection.Ascending)
                    " ↑"
                else
                    " ↓"
                if (sorting.size > 1L)
                    title += f"${priority + 1L}"
            }
        }
        return element(
            GridCellProps<Row>(
                None,
                0L,
                index,
                column.id,
                Some(title),
                columns.appearance,
                None,
                column.sortable,
                if (column.sortable)
                    Some {
                        additive ->
                        session.editing.leave { model.toggleSort(column.id, additive) };
                        Unit
                    }
                else
                    None,
                multiSortModifier = modifier
            ),
            { props, scope -> GridCell(props, scope) },
            [columns.appearance.label(title)]
        )
    }
}

internal class GridCellProps<Row>(
    val address: GridCellAddress?,
    val row: Long,
    val column: Long,
    val id: GridColumnId,
    val text: String?,
    val appearance: GridAppearance,
    val session: GridSession<Row>?,
    val tabStop: Boolean = true,
    val activate: ((Boolean) -> Unit)? = None,
    val content: GridContentHandle? = None,
    val editable: Boolean = false,
    val error: String? = None,
    val submitting: Boolean = false,
    val multiSortModifier: GridMultiSortModifier = GridMultiSortModifier.Shift
)

internal class GridCell<Row>(
    private val props: Props<GridCellProps<Row>>,
    scope: ComponentScope
): Element<GridCellClip>(scope) {
    private val handle = FocusHandle()
    private val area = scope.createArea(focusable = true)
    private val focus = scope.focusTarget(area, FocusOptions(Some(handle), props.value.tabStop))
    private val semantics =
        scope.semantics(
            if (props.value.address == None)
                SemanticRole.ColumnHeader
            else
                SemanticRole.Cell
        )
    private val press =
        scope.press(area, PressOptions(acceptsEnter = props.value.address == None)) { activate() }
    private var registered: GridCellAddress? = None
    private var doubleClick = false
    private var additiveSort = false
    init {
        scope.routeChildren(area)
        scope.routeSemanticsChildren(Some(semantics))
        semantics.mergeLabels = true
        semantics.bindFocus(Some(focus))
        scope.resource {
            area.scope.addEventHandler {
                _,
                event -> when (event) {
                    case Pointer(
                        InputPointerEvent.Button(
                            val pointer,
                            MouseButton.Left,
                            val state,
                            val clicks
                        )
                    ) -> {
                        additiveSort =
                            gridAdditiveSort(pointer.state.modifiers, props.value.multiSortModifier)
                        if (state == ElementState.Pressed)
                            doubleClick = clicks >= 2
                    }
                    case Contact(InputContactEvent.Began(val value)) -> additiveSort =
                        gridAdditiveSort(value.pointer.modifiers, props.value.multiSortModifier)
                    case Contact(InputContactEvent.Ended(val value)) -> additiveSort =
                        gridAdditiveSort(value.pointer.modifiers, props.value.multiSortModifier)
                    case Keyboard(val key) -> additiveSort =
                        gridAdditiveSort(key.modifiers, props.value.multiSortModifier)
                    case Pointer(InputPointerEvent.Cancelled(_, _)) -> {
                        doubleClick = false
                        additiveSort = false
                    }
                    else -> {}
                }
            }
        }
        scope.resource {
            area.scope.addEventFinished {
                event -> when (event) {
                    case Pointer(
                        InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
                    ) -> doubleClick = false
                    else -> {}
                }
            }
        }
        scope.resource {
            area.scope.addDefaultAction { context, event -> keyboard(context, event) }
        }
        scope.resource {
            scope.input.observeActivity {
                if (scope.isMounted) {
                    if (scope.input.activity.hasFocus) {
                        when (props.value.address) {
                            case Some(val address) -> props.value.session?.remember(address);
                            case None -> {}
                        }
                    }
                    scope.requestFrame()
                }
            }
        }
    }
    public override fun onMount() {
        when (props.value.address) {
            case Some(val address) -> {
                props.value.session!!.register(address, GridCellFocus(handle, focus, scope))
                registered = Some(address)
            }
            case None -> {}
        }
    }
    public override fun onUnmount() {
        when (registered) {
            case Some(val address) -> props.value.session?.remove(address);
            case None -> {}
        }
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        area.scope.textCommandAvailability =
            Some(TextCommandAvailability(paste = input.editable && !input.submitting))
        semantics.update(
            SemanticProperties(
                name =
                    if (input.address == None)
                        input.text
                    else
                        None,
                value =
                    if (input.address == None)
                        None
                    else
                        input.text,
                readOnly = !input.editable,
                invalid = input.error != None,
                description = input.error,
                error = input.error,
                busy = input.submitting,
                cell =
                    if (input.address == None)
                        None
                    else
                        Some(
                            SemanticTableCell(
                                input.row,
                                input.column,
                                columnKey = Some(SemanticItemKey.Text(input.id.value))
                            )
                        )
            )
        )
        if (input.address == None)
            focus.options = FocusOptions(Some(handle), input.tabStop)
        return UiInvalidation.Layout
    }
    private fun activate() {
        when (props.value.activate) {
            case Some(val action) -> action(additiveSort)
            case None -> when (props.value.address) {
                case Some(val address) -> if (doubleClick && props.value.editable)
                    props.value.session?.beginEdit(address)
                else
                    props.value.session?.focus(address)
                case None -> handle.requestFocus()
            }
        }
    }
    private fun keyboard(context: RoutedEventContext, event: InputEvent) {
        val address = props.value.address ?: return headerKey(context, event)
        if (handle.hasFocus && gridPasteCommand(event)) {
            props.value.session?.pasteClipboard(address)
            context.consume()
            return
        }
        val key =
            when (event) {
                case Keyboard(val value) -> value;
                else -> return
            }
        if (gridPlainKey(key)) {
            if (
                handle.hasFocus &&
                    (
                        key.logicalKey ==
                            LogicalKey.Named(NamedKey.Enter) ||
                            key.logicalKey ==
                            LogicalKey.Named(NamedKey.F2)
                    )
            ) {
                if (props.value.editable) {
                    props.value.session?.beginEdit(address)
                    context.consume()
                } else
                    if (props.value.content?.enter() ?: false)
                        context.consume()
                return
            }
            val edit = props.value.session?.editing?.cell(address) ?: None
            when (edit) {
                case Some(val active) -> {
                    if (key.logicalKey == LogicalKey.Named(NamedKey.Escape)) {
                        if (!active.draft.composing)
                            props.value.session?.cancelEdit()
                        context.consume()
                        return
                    }
                    if (key.logicalKey == LogicalKey.Named(NamedKey.Enter)) {
                        props.value.session?.commitEdit()
                        context.consume()
                        return
                    }
                }
                case None -> {}
            }
            if (!handle.hasFocus && key.logicalKey == LogicalKey.Named(NamedKey.Escape)) {
                if (handle.requestFocus(FocusOrigin.Keyboard))
                    context.consume()
                return
            }
        }
        if (
            (handle.hasFocus || key.logicalKey == LogicalKey.Named(NamedKey.Tab)) &&
                (props.value.session?.navigate(address, key) ?: false)
        )
            context.consume()
    }
    private fun headerKey(context: RoutedEventContext, event: InputEvent) {
        val key =
            when (event) {
                case Keyboard(val value) -> value
                else -> return
            }
        val action = props.value.activate ?: return
        if (handle.hasFocus && gridHeaderSortKey(key, props.value.multiSortModifier)) {
            if (!key.isRepeat)
                action(true)
            context.consume()
        }
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        GridCellClip
    > {
        val clip = context.input<GridCellClip>()
        val size = constraints.constrain(Size(0.0, 0.0))
        val inset = min(props.value.appearance.padding, min(size.width, size.height) / 2.0)
        val child =
            context.measureChild(
                0L,
                Constraints(
                    maxWidth = Some(max(0.0, size.width - inset * 2.0)),
                    maxHeight = Some(max(0.0, size.height - inset * 2.0))
                )
            )
        context.placeChild(
            0L,
            Point(
                if (context.layoutDirection == LayoutDirection.Rtl)
                    max(inset, size.width - inset - child.size.width)
                else
                    inset,
                max(inset, (size.height - child.size.height) / 2.0)
            )
        )
        return LayoutResult(LayoutMetrics(size), clip)
    }
    public override fun scene(context: SceneContext, clip: GridCellClip) {
        context.withScrollReveal(clip.viewport, clip.region, clip.axes) {
            cell -> present(cell, clip.bounds)
        }
    }
    private fun present(context: SceneContext, clip: Rect) {
        val input = props.value
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        val palette = input.appearance.theme.tokens.palette
        val background =
            if (input.address == None)
                palette.muted.background
            else
                palette.background.background
        val focused = handle.isFocusVisible
        val line = input.appearance.density
        context.clipRect(clip)
        context.draw {
            paint ->
            paint.canvas.drawRect(bounds, Paint(background))
            paint.canvas.drawRect(
                Rect(0.0, max(0.0, bounds.height - line), bounds.width, min(line, bounds.height)),
                Paint(palette.border)
            )
            paint.canvas.drawRect(
                Rect(max(0.0, bounds.width - line), 0.0, min(line, bounds.width), bounds.height),
                Paint(palette.border)
            )
        }
        context.place(area, bounds)
        context.semantics(semantics, bounds)
        context.children()
        if (focused)
            context.draw {
                paint ->
                val stroke = min(2.0 * line, min(bounds.width, bounds.height))
                val ink = Paint(palette.ring)
                paint.canvas.drawRect(Rect(0.0, 0.0, bounds.width, stroke), ink)
                paint.canvas.drawRect(Rect(0.0, bounds.height - stroke, bounds.width, stroke), ink)
                paint.canvas.drawRect(Rect(0.0, 0.0, stroke, bounds.height), ink)
                paint.canvas.drawRect(Rect(bounds.width - stroke, 0.0, stroke, bounds.height), ink)
            }
    }
}
