package scoop.grid

import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.ui.*

/** Finish size discovery before placing the header and publishing one scroll layout. */
internal fun <Row> gridMeasureRows(
    context: MeasureContext,
    input: GridRootProps<Row>,
    viewport: ScrollViewport,
    size: Size,
    columns: GridColumnLayout,
    headerRowHeight: Double,
    headerHeight: Double
): GridRootLayout<Row> {
    val rows = input.session.rowHeights.prepare(input, columns)
    val anchor = input.session.rowHeights.anchor(input)
    val available = max(0.0, size.height - headerHeight)
    val revision = input.scroll.requestRevision
    val density = input.columns.appearance.density
    fun layout(): GridMeasurePlan {
        val bands =
            GridRowLayout(rows.index, input.rows.topCount, input.rows.bottomCount, available)
        val bodyHeight = bands.bodyHeight
        val content =
            Size(
                columns.total,
                bands.bodyExtent + headerHeight + bands.topVisible + bands.bottomVisible
            )
        var scroll = viewport.layout(size, content)
        val old = scroll.snapshot.offset
        var adjusted: Point? = None
        when (input.session.preparing) {
            case Some(val target) -> when (input.rows.indexOfKey(target.row)) {
                case Some(val index) -> {
                    val top = bands.bodyPosition(index)
                    val height = rows.index.extent(index)
                    val y =
                        if (bands.fixed(index))
                            old.y
                        else
                            if (top < old.y || height > bodyHeight)
                                top
                            else
                                if (top + height > old.y + bodyHeight)
                                    top + height - bodyHeight
                                else
                                    old.y
                    val x =
                        when (input.columns.indexOf(target.column)) {
                            case Some(val at) -> {
                                val span =
                                    input.rows.spansFor(input.rows.source.rowAt(index)).span(at)
                                columns.reveal(span.column, old.x, span.count)
                            }
                            case None -> old.x
                        }
                    adjusted = Some(Point(x, y))
                }
                case None -> {}
            }
            case None -> when (
                if (input.session.requested == None)
                    anchor
                else
                    None
            ) {
                case Some(val value) -> adjusted =
                    Some(
                        Point(
                            old.x,
                            bands.bodyPosition(value.index) +
                                min(value.inside, rows.index.extent(value.index))
                        )
                    )
                case None -> {}
            }
        }
        when (adjusted) {
            case Some(val offset) -> scroll =
                viewport.layout(size, content, Some(ScrollAdjustment(revision, offset)))
            case None -> {}
        }
        return GridMeasurePlan(
            columns,
            scroll,
            rows,
            headerHeight,
            bands,
            input.input.overscan * density,
            columns.visible(scroll.presentationOffset.x),
            viewport,
            input.columns.headers,
            headerRowHeight
        )
    }
    var plan = layout()
    while (true) {
        val before = rows.revision
        context.measureChild(
            0L,
            Constraints.tight(Size(columns.total, headerHeight)),
            LayoutInput(plan)
        )
        context.measureChild(
            1L,
            Constraints.tight(Size(columns.total, max(rows.index.total, available))),
            LayoutInput(plan)
        )
        if (rows.revision == before)
            break
        plan = layout()
    }
    val measured =
        when (val probe = input.session.columnSizing.probe(input, plan)) {
            case Some(val value) -> Some(
                gridMeasureColumnContent(
                    context,
                    plan,
                    value,
                    input.columns.appearance.sampleWidth(input.columns.columns[value.column].size),
                    density,
                    max(rows.index.total, available)
                )
            )
            case None -> None
        }
    val shared = LayoutInput(plan)
    context.measureChild(0L, Constraints.tight(Size(columns.total, headerHeight)), shared)
    context.placeChild(
        0L,
        Point(0.0, plan.scroll.presentationOffset.y - plan.scroll.snapshot.offset.y)
    )
    when (measured) {
        case Some(_) -> context.measureChild(
            1L,
            Constraints.tight(Size(columns.total, max(rows.index.total, available))),
            shared
        )
        case None -> {}
    }
    context.placeChild(1L, Point(0.0, headerHeight))
    return GridRootLayout(plan, measured, input.session.rowHeights.capture(input, plan))
}
