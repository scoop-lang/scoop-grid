package scoop.grid

import scoop.collections.HashSet
import scoop.collections.sortWith
import scoop.comparisons.comparatorOf
import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.ui.*
import scoop.ui.component.TableSource
import scoop.window.accessibility.*

internal class GridRows<Row>(
    val source: TableSource<Row>,
    val columns: GridColumnsPlan<Row>,
    val session: GridSession<Row>,
    val policy: GridRowPolicy<Row>,
    val enabled: Boolean = true,
    val topCount: Long = 0L,
    val bottomCount: Long = 0L
): ItemSource {
    public override val count: Long get() = source.count
    public override fun keyAt(index: Long): ViewKey = source.keyAt(index)
    public override fun indexOfKey(key: ViewKey): Long? = source.indexOfKey(key)
    public override fun build(index: Long): View {
        val row = source.rowAt(index)
        val key = keyAt(index)
        val cells = GridRowCells(row, key, index, columns, session, policy, enabled)
        return lazyElement(
            cells,
            GridRowProps(row, index, key, columns, session, policy),
            { props, scope -> GridRow(props, scope) }
        )
    }
    fun semantics(): ItemSemantics =
        ItemSemantics(
            this,
            { _ -> Some(SemanticItemProperties(enabled = enabled, focusable = true)) },
            grid =
                Some(
                    SemanticGrid(
                        Array<SemanticGridColumn>(columns.columns.size) {
                            index ->
                            val column = columns.columns[index]
                            SemanticGridColumn(
                                SemanticItemKey.Text(column.id.value),
                                Some(column.title)
                            )
                        },
                        {
                            key, column ->
                            val viewKey =
                                when (key) {
                                    case Number(val value) -> ViewKey.Number(value);
                                    case Text(val value) -> ViewKey.Text(value)
                                }
                            val index = source.indexOfKey(viewKey)
                            when (index) {
                                case Some(val at) -> Some(
                                    SemanticItemProperties(
                                        value = columns.columns[column].text(source.rowAt(at)),
                                        enabled = enabled,
                                        focusable = true
                                    )
                                )
                                case None -> None
                            }
                        }
                    )
                )
        )
}

internal class GridBodyProps<Row>(val rows: GridRows<Row>, val session: GridSession<Row>)

internal class GridBody<Row>(
    private val props: Props<GridBodyProps<Row>>,
    scope: ComponentScope
): LazyElement<Rect>(scope) {
    private val semantics = scope.semantics(SemanticRole.Table)
    public override fun onMount() {
        props.value.session.tableSemantics = Some(semantics)
        props.value.session.bodyFocus =
            Some(
                scope.lazyFocus(
                    props.value.session.viewport!!,
                    LazyFocusOptions(ItemNavigation.Roving())
                )
            )
        scope.routeSemanticsChildren(Some(semantics))
    }
    public override fun update(): UiInvalidation {
        val rows = props.value.rows
        semantics.update(
            SemanticProperties(
                name = Some("Data grid"),
                enabled = rows.enabled,
                table = Some(SemanticTableSize(rows.count, rows.columns.columns.size))
            )
        )
        semantics.updateCollection(rows, Some(rows.semantics()), props.value.session.viewport)
        return UiInvalidation.Layout
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Rect> {
        val plan = context.input<GridMeasurePlan>()
        when (plan.probe) {
            case Some(val probe) -> return gridMeasureContentRows(context, constraints, plan, probe)
            case None -> {}
        }
        val offset = plan.scroll.presentationOffset
        val selected = HashSet<Long>()
        val extents = plan.rows.index
        for (index in plan.bands.visible(offset.y, plan.overscan, plan.columns.viewport))
            selected.add(index)
        for (index in context.pinnedItems)
            selected.add(index)
        when (props.value.session.requested) {
            case Some(val target) -> when (props.value.rows.indexOfKey(target.row)) {
                case Some(val index) -> selected.add(index)
                case None -> {}
            }
            case None -> {}
        }
        when (props.value.session.editing.current) {
            case Some(val edit) -> when (props.value.rows.indexOfKey(edit.address.row)) {
                case Some(val index) -> selected.add(index)
                case None -> {}
            }
            case None -> {}
        }
        for (index in selected) {
            val metrics =
                context.measureItem(
                    index,
                    if (extents.variable)
                        Constraints(
                            minWidth = plan.columns.total,
                            maxWidth = Some(plan.columns.total)
                        )
                    else
                        Constraints.tight(Size(plan.columns.total, plan.rows.estimate))
                )
            plan.rows.record(index, props.value.rows.keyAt(index), metrics.size.height)
        }
        for (index in selected) {
            val row = plan.bands.box(index, offset.y, extents.extent(index))
            context.placeItem(index, Point(0.0, row.y + offset.y - plan.scroll.snapshot.offset.y))
        }
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(plan.columns.total, 0.0))),
            Rect(
                offset.x - plan.scroll.snapshot.offset.x,
                offset.y - plan.scroll.snapshot.offset.y,
                plan.columns.viewport,
                plan.bands.available
            )
        )
    }
    public override fun scene(context: SceneContext, clip: Rect) {
        context.clipRect(clip)
        context.semantics(semantics, clip)
        context.children()
    }
}

internal class GridRowProps<Row>(
    val row: Row,
    val index: Long,
    val key: ViewKey,
    val columns: GridColumnsPlan<Row>,
    val session: GridSession<Row>,
    val policy: GridRowPolicy<Row>
)

internal class GridRow<Row>(
    private val props: Props<GridRowProps<Row>>,
    scope: ComponentScope
): LazyElement<Unit>(scope) {
    private val semantics = scope.semantics(SemanticRole.Row)
    public override fun onMount() {
        scope.bindGridColumns(props.value.session.tableSemantics!!, props.value.key)
    }
    public override fun update(): UiInvalidation {
        scope.routeSemanticsChildren(Some(semantics))
        return UiInvalidation.Layout
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Unit> {
        val plan = context.input<GridMeasurePlan>()
        when (plan.probe) {
            case Some(val probe) -> return gridMeasureContentCell(
                context,
                constraints,
                plan,
                probe,
                false
            )
            case None -> {}
        }
        val selected = HashSet<Long>()
        for (index in plan.visibleColumns)
            selected.add(index)
        for (index in props.value.policy.contributors)
            selected.add(index)
        for (index in context.pinnedItems)
            selected.add(index)
        when (props.value.session.requested) {
            case Some(val address) -> if (address.row == props.value.key) {
                when (props.value.columns.indexOf(address.column)) {
                    case Some(val index) -> selected.add(index);
                    case None -> {}
                }
            }
            case None -> {}
        }
        when (props.value.session.editing.current) {
            case Some(val edit) -> if (edit.address.row == props.value.key) {
                when (props.value.columns.indexOf(edit.address.column)) {
                    case Some(val index) -> selected.add(index)
                    case None -> {}
                }
            }
            case None -> {}
        }
        var height = props.value.policy.height(props.value.row, plan.rows.estimate)
        for (index in props.value.policy.contributors) {
            val box = plan.columns.box(index, plan.scroll.presentationOffset.x, height)
            if (box.width <= 0.0)
                continue
            val metrics =
                context.measureItem(
                    index,
                    Constraints(minWidth = box.width, maxWidth = Some(box.width)),
                    LayoutInput(
                        GridCellClip(
                            box.clip,
                            plan.columns.region(index, plan.headerHeight, plan.bodyHeight),
                            ScrollAxes.Both,
                            plan.viewport,
                            GridCellMeasure.Height
                        )
                    )
                )
            height = max(height, metrics.size.height)
        }
        for (index in selected) {
            val box = plan.columns.box(index, plan.scroll.presentationOffset.x, height)
            val row = plan.bands.box(props.value.index, plan.scroll.presentationOffset.y, height)
            context.measureItem(
                index,
                Constraints.tight(Size(box.width, height)),
                LayoutInput(
                    GridCellClip(
                        Rect(box.clip.x, row.clipTop, box.clip.width, row.clipHeight),
                        plan.columns.region(
                            index,
                            plan.headerHeight + row.regionTop,
                            row.regionHeight
                        ),
                        if (plan.columns.frozen(index))
                            ScrollAxes.Vertical
                        else
                            ScrollAxes.Both,
                        plan.viewport,
                        fixedRow = row.fixed
                    )
                )
            )
            context.placeItem(index, Point(box.x - plan.scroll.snapshot.offset.x, 0.0))
        }
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(plan.columns.total, height))),
            Unit
        )
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.semantics(semantics, Rect(0.0, 0.0, context.size.width, context.size.height))
        context.children()
    }
}

internal class GridHeader(scope: ComponentScope): LazyElement<Unit>(scope) {
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Unit> {
        val plan = context.input<GridMeasurePlan>()
        when (plan.probe) {
            case Some(val probe) -> return gridMeasureContentCell(
                context,
                constraints,
                plan,
                probe,
                true
            )
            case None -> {}
        }
        val selected = HashSet<Long>()
        for (index in plan.visibleColumns) {
            selected.add(index)
            for (ancestor in plan.headers.ancestors[index])
                selected.add(ancestor)
        }
        for (index in context.pinnedItems) {
            selected.add(index)
            for (ancestor in plan.headers.ancestors[index])
                selected.add(ancestor)
        }
        val ordered = ArrayList<Long>()
        for (index in selected)
            ordered.add(index)
        ordered.sortWith(
            comparatorOf<Long> {
                left, right ->
                val depth = plan.headers.items[left].level - plan.headers.items[right].level
                if (depth == 0L)
                    left - right
                else
                    depth
            }
        )
        for (index in ordered) {
            val item = plan.headers.items[index]
            val box =
                plan.headers.box(
                    index,
                    plan.columns,
                    plan.scroll.presentationOffset.x,
                    plan.headerRowHeight,
                    plan.headerHeight
                )
            context.measureItem(
                index,
                Constraints.tight(Size(box.width, box.height)),
                LayoutInput(
                    GridCellClip(
                        box.clip,
                        box.region,
                        if (plan.columns.frozen(item.first))
                            ScrollAxes.Vertical
                        else
                            ScrollAxes.Horizontal,
                        plan.viewport,
                        fixedRow = true
                    )
                )
            )
            context.placeItem(index, Point(box.x - plan.scroll.snapshot.offset.x, box.y))
        }
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(plan.columns.total, plan.headerHeight))),
            Unit
        )
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.children()
    }
}
