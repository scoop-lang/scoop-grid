package scoop.grid

import scoop.text.*
import scoop.ui.*
import scoop.ui.component.*

public class GridBooleanEditor public constructor(initial: Boolean): GridEditor<Boolean> {
    public val value: State<Boolean> = state(initial)
    private val reference = FieldTarget()
    public override val composing: Boolean get() = false
    public override fun candidate(): GridCandidate<Boolean> = GridCandidate.Value(value.value)
    public override fun importText(text: String): String? {
        when (text.trim().lowercaseAscii()) {
            case "true" -> value.value = true
            case "1" -> value.value = true
            case "是" -> value.value = true
            case "false" -> value.value = false
            case "0" -> value.value = false
            case "否" -> value.value = false
            else -> return Some("请输入 true／false、1／0 或是／否")
        }
        return None
    }
    public override fun cancelComposition(): Unit = Unit
    public override fun view(options: GridEditorOptions): View {
        val draft = value
        val reference = this.reference
        val control =
            checkbox(
                binding(
                    { draft.value },
                    {
                        next -> if (!options.submitting) {
                            draft.value = next
                            options.onEdited()
                        }
                    }
                )
            ) {
                focus = FocusOptions(Some(options.focus))
                enabled = !options.submitting
                invalid = options.error != None
                theme = Some(options.theme)
                labelTarget = Some(reference)
            }
        return gridEditorField(
            control,
            options,
            reference,
            Some(
                if (draft.value)
                    "是"
                else
                    "否"
            )
        )
    }
}

public fun gridBooleanEditor(value: Boolean): GridBooleanEditor = GridBooleanEditor(value)
