package scoop.grid

import scoop.ui.View
import scoop.ui.component.*

internal fun gridEditorField(
    control: View,
    options: GridEditorOptions,
    reference: FieldTarget,
    caption: String? = None
): View =
    field(control) {
        target = Some(reference)
        fonts = Some(options.fonts)
        theme = Some(options.theme)
        spacing = Some(2.0)
        contentSpacing = Some(2.0)
        invalid = options.error != None
        when (caption) {
            case Some(val text) -> {
                label(text, reference)
                orientation = FieldOrientation.Horizontal
                controlPlacement = FieldControlPlacement.Start
            }
            case None -> {}
        }
        when (options.error) {
            case Some(val message) -> error(message)
            case None -> {}
        }
        if (options.submitting)
            description(options.savingText)
    }
