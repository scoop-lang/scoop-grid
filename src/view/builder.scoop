package scoop.grid

import scoop.graphics.text.FontCollection
import scoop.ui.*
import scoop.ui.style.ThemeSource

public class DataGridProps<Row> public constructor(
    public val state: DataGridState<Row>,
    public val height: Double = 320.0,
    public val width: Double? = None,
    public val rowHeight: Double = 48.0,
    public val headerHeight: Double = 40.0,
    public val overscan: Double = 48.0,
    public val scroll: ScrollState? = None,
    public val handle: DataGridHandle? = None,
    public val enabled: Boolean = true,
    public val fonts: FontCollection? = None,
    public val theme: ThemeSource? = None,
    public val onEditEnd: (GridEditEnd) -> Unit = { _ -> Unit },
    public val onPasteResult: (GridCellAddress, GridPasteResult) -> Unit = { _, _ -> Unit },
    public val multiSortModifier: GridMultiSortModifier = GridMultiSortModifier.Shift,
    public val minimumCenterWidth: Double = 80.0
) {
    init {
        gridRequire(height.isFinite() && height >= 0.0, "invalid grid height")
        when (width) {
            case Some(val value) -> gridRequire(
                value.isFinite() && value >= 0.0,
                "invalid grid width"
            )
            case None -> {}
        }
        gridRequire(rowHeight.isFinite() && rowHeight > 0.0, "invalid grid row height")
        gridRequire(headerHeight.isFinite() && headerHeight >= 0.0, "invalid grid header height")
        gridRequire(overscan.isFinite() && overscan >= 0.0, "invalid grid overscan")
        gridRequire(
            minimumCenterWidth.isFinite() && minimumCenterWidth >= 0.0,
            "invalid grid center minimum width"
        )
    }
}

public class DataGridBuilder internal constructor() {
    public var height: Double = 320.0
    public var width: Double? = None
    public var rowHeight: Double = 48.0
    public var headerHeight: Double = 40.0
    public var overscan: Double = 48.0
    public var scroll: ScrollState? = None
    public var handle: DataGridHandle? = None
    public var enabled: Boolean = true
    public var fonts: FontCollection? = None
    public var theme: ThemeSource? = None
    public var onEditEnd: (GridEditEnd) -> Unit = { _ -> Unit }
    public var onPasteResult: (GridCellAddress, GridPasteResult) -> Unit = { _, _ -> Unit }
    public var multiSortModifier: GridMultiSortModifier = GridMultiSortModifier.Shift
    public var minimumCenterWidth: Double = 80.0
    public var key: ViewKey = ViewKey.Position
    internal fun <Row> snapshot(state: DataGridState<Row>): DataGridProps<Row> =
        DataGridProps(
            state,
            height,
            width,
            rowHeight,
            headerHeight,
            overscan,
            scroll,
            handle,
            enabled,
            fonts,
            theme,
            onEditEnd,
            onPasteResult,
            multiSortModifier,
            minimumCenterWidth
        )
}

public fun <Row> dataGrid(
    state: DataGridState<Row>,
    configure: DataGridBuilder.() -> Unit = {}
): View {
    val builder = DataGridBuilder()
    builder.configure()
    return component(
        builder.snapshot(state),
        { props, scope -> DataGrid(props, scope) },
        builder.key
    )
}
