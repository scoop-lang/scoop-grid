package scoop.grid

import scoop.surface.InputEvent
import scoop.window.ElementState

internal fun gridCopyCommand(event: InputEvent): Boolean {
    when (event) {
        case TextCommand(val command) -> return when (command) {
            case Copy -> true
            else -> false
        }
        case Keyboard(val key) -> {
            if (key.state != ElementState.Pressed || key.synthetic)
                return false
            for (command in key.textCommands)
                when (command) {
                    case Copy -> return true
                    else -> {}
                }
        }
        else -> {}
    }
    return false
}
