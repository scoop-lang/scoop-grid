package scoop.grid

import scoop.collections.HashMap
import scoop.math.max
import scoop.math.min
import scoop.platform.time.MonotonicInstant
import scoop.surface.*
import scoop.ui.*
import scoop.ui.component.TableSource
import scoop.ui.style.ThemeSource
import scoop.window.KeyEvent
import scoop.window.ElementState
import scoop.window.MouseButton
import scoop.window.clipboard
import scoop.window.WindowException

internal class GridCellFocus(
    val handle: FocusHandle,
    val target: FocusTarget,
    val scope: ComponentScope
)

internal class GridSession<Row>: GridMount {
    var viewport: ScrollViewport? = None
    var bodyFocus: LazyFocus? = None
    var tableSemantics: SemanticsHandle? = None
    var theme: ThemeSource? = None
    var entry: FocusHandle? = None
    val editing = GridEditCoordinator<Row>(this)
    val columnActions = GridColumnActions<Row>(this)
    val columnReorder = GridColumnReorder<Row>(this)
    val columnSizing = GridColumnSizing<Row>(this)
    private var owner: ComponentScope? = None
    private var model: DataGridState<Row>? = None
    private val rows: TableSource<Row>? get() = model?.result?.rows
    private var columns: GridColumnsPlan<Row>? = None
    private var reference: DataGridHandle? = None
    var enabled = true
    private var intent: GridCellAddress? = None
    private var recent: GridColumnId? = None
    private val cells = HashMap<GridCellAddress, GridCellFocus>()
    private var pageRows = 1L
    private var onPasteResult: (GridCellAddress, GridPasteResult) -> Unit = { _, _ -> Unit }
    fun accept(
        plan: GridMeasurePlan,
        input: GridRootProps<Row>,
        time: MonotonicInstant?,
        measured: GridColumnMeasured?
    ) {
        if (active) {
            pageRows = max(1L, (plan.bodyHeight / plan.rowHeight).toLong())
            columnActions.accept(plan, input)
            columnReorder.accept(plan, input, time)
            columnSizing.accept(plan, input, measured)
        }
    }
    fun requestFrame() {
        if (active)
            owner?.requestFrame()
    }
    fun requestLayout() {
        if (active)
            owner?.requestLayout()
    }
    public override val columnStates: Array<GridColumnState>? get() = columnActions.states
    public override fun setColumnState(value: GridColumnState): GridColumnActionResult =
        columnActions.change(value)
    public override fun moveColumn(id: GridColumnId, index: Long): GridColumnActionResult =
        columnActions.move(id, index)
    public override fun fitColumns(): GridColumnActionResult = columnActions.fit()
    public override fun fitColumnToContent(id: GridColumnId): GridColumnFit = columnSizing.begin(id)
    fun navigate(address: GridCellAddress, key: KeyEvent): Boolean {
        if (!active || !enabled)
            return false
        val source = rows ?: return false
        val plan = columns ?: return false
        val command = gridNavigation(key, plan.appearance.direction) ?: return false
        val row = source.indexOfKey(address.row) ?: return false
        val column = plan.indexOf(address.column) ?: return false
        val next =
            gridNextCell(
                GridCellIndex(row, column),
                source.count,
                plan.columns.size,
                pageRows,
                command
            )
        when (next) {
            case None -> {
                when (editing.current) {
                    case None -> return false
                    case Some(_) -> when (command) {
                        case Tab(val reverse) -> {
                            editing.submit(
                                Some {
                                    owner?.moveFocus(reverse);
                                    Unit
                                }
                            )
                            return true
                        }
                        else -> return false
                    }
                }
            }
            case Some(_) -> {}
        }
        val target = next!!
        if (target.row != row || target.column != column) {
            val address = GridCellAddress(source.keyAt(target.row), plan.columns[target.column].id)
            editing.leave { restore(address, target.row) }
        }
        return true
    }
    public override val active: Boolean get() = owner?.isMounted ?: false
    public override val pending: Boolean get() = requested != None
    public override val requested: GridCellAddress? get() {
        if (!active)
            return None
        for ((address, cell) in cells)
            if (cell.handle.isPending)
                return Some(address)
        return if (bodyFocus?.isPending ?: false)
            intent
        else
            None
    }
    public override val focused: GridCellAddress? get() {
        for ((address, cell) in cells)
            if (cell.scope.input.activity.hasFocus)
                return Some(address)
        return None
    }
    fun mount(scope: ComponentScope, value: ScrollViewport) {
        owner = Some(scope)
        viewport = Some(value)
    }
    fun windowHasFocus(): Boolean {
        var input = owner?.input ?: return false
        while (true) {
            val parent = input.parent ?: return input.activity.hasFocus
            input = parent
        }
    }
    fun capture(context: RoutedEventContext, event: InputEvent) {
        val edit = editing.current ?: return
        val press =
            when (event) {
                case Pointer(
                    InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
                ) -> true
                case Contact(InputContactEvent.Began(_)) -> true
                else -> false
            }
        if (!press)
            return
        val cell = cells[edit.address] ?: return
        var target: InputScope? = Some(context.target)
        while (true) {
            val current = target ?: break
            if (current === cell.scope.input)
                return
            target = current.parent
        }
        if (editing.beforePress())
            context.consume()
    }
    fun update(input: GridRootProps<Row>) {
        columnActions.update(input)
        model = Some(input.input.state)
        columns = Some(input.columns)
        theme = Some(input.theme)
        enabled = input.input.enabled
        onPasteResult = input.input.onPasteResult
        editing.update(input.input)
        columnReorder.update(input)
        columnSizing.update(input)
        val sameHandle =
            when ((reference, input.input.handle)) {
                case(Some(val old), Some(val next)) -> old === next
                case(None, None) -> true
                else -> false
            }
        if (!sameHandle) {
            reference?.unbind(this)
            reference = input.input.handle
            reference?.bind(this)
        }
        when (requested) {
            case Some(val address) -> if (!valid(address))
                cancel()
            case None -> {}
        }
    }
    fun unmount() {
        columnSizing.close()
        columnReorder.close()
        columnActions.close()
        editing.close()
        reference?.unbind(this)
        reference = None
        owner = None
        viewport = None
        bodyFocus = None
        tableSemantics = None
        intent = None
        model = None
        theme = None
        entry = None
    }
    private fun valid(address: GridCellAddress): Boolean {
        val source = rows ?: return false
        val plan = columns ?: return false
        return enabled &&
            source.indexOfKey(address.row) !=
            None &&
            plan.indexOf(address.column) !=
            None &&
            (model?.visibleColumn(address.column) ?: false)
    }
    public override fun focus(address: GridCellAddress): Boolean {
        if (!active || !valid(address))
            return false
        when (editing.cell(address)) {
            case Some(val edit) -> return requestCell(address, Some(edit.focus))
            case None -> {}
        }
        return editing.leave { requestCell(address) }
    }
    fun requestCell(address: GridCellAddress, editor: FocusHandle? = None): Boolean {
        if (!active || !valid(address))
            return false
        val focus = bodyFocus ?: return false
        intent = Some(address)
        val select: () -> FocusHandle? =
            {
                when (editor) {
                    case Some(val handle) -> Some(handle)
                    case None -> cells[address]?.handle
                }
            }
        val accepted = focus.requestFocus(address.row, select)
        if (!accepted)
            intent = None
        return accepted
    }
    fun restore(address: GridCellAddress, index: Long) {
        if (!active || !enabled)
            return
        val source = rows ?: return
        val plan = columns ?: return
        if (source.count == 0L || plan.columns.size == 0L) {
            entry?.requestFocus()
            return
        }
        val at = source.indexOfKey(address.row) ?: min(index, source.count - 1L)
        if (model?.visibleColumn(address.column) ?: false) {
            requestCell(GridCellAddress(source.keyAt(at), address.column))
            return
        }
        for (column in plan.columns)
            if (model?.visibleColumn(column.id) ?: false) {
                requestCell(GridCellAddress(source.keyAt(at), column.id))
                return
            }
        entry?.requestFocus()
    }
    public override val editingCell: GridCellAddress? get() = editing.current?.address
    public override val editError: String? get() = editing.current?.error ?: None
    public override val submitting: Boolean get() = editing.current?.submitting ?: false
    public override fun beginEdit(address: GridCellAddress): Boolean = editing.begin(address)
    public override fun commitEdit(): GridEditAttempt = editing.submit()
    public override fun cancelEdit(): Boolean = editing.cancel()
    public override fun pasteCell(address: GridCellAddress, text: String): GridPasteResult {
        val result = editing.paste(address, text)
        onPasteResult(address, result)
        return result
    }
    fun pasteClipboard(address: GridCellAddress) {
        val scope = owner ?: return
        val text =
            try {
                scope.nativeWindow.clipboard.readText()
            } catch (error: WindowException) {
                onPasteResult(address, GridPasteResult.Rejected("无法读取剪贴板"))
                return
            }
        val result =
            when (text) {
                case Some(val value) -> editing.paste(address, value)
                case None -> GridPasteResult.Rejected("剪贴板中没有可粘贴的文本")
            }
        onPasteResult(address, result)
    }
    public override fun cancel() {
        bodyFocus?.cancelRequest()
        for ((_, cell) in cells)
            if (cell.handle.isPending)
                cell.handle.clearFocus()
        intent = None
    }
    fun register(address: GridCellAddress, cell: GridCellFocus) {
        gridRequire(!cells.containsKey(address), "duplicate mounted grid cell")
        cells.put(address, cell)
        updateOrder(address, cell)
    }
    fun remove(address: GridCellAddress) {
        cells.remove(address)
    }
    fun remember(address: GridCellAddress) {
        if (recent == Some(address.column))
            return
        recent = Some(address.column)
        for ((key, cell) in cells)
            updateOrder(key, cell)
    }
    private fun updateOrder(address: GridCellAddress, cell: GridCellFocus) {
        cell.target.options =
            FocusOptions(
                Some(cell.handle),
                order =
                    if (recent == Some(address.column))
                        -1
                    else
                        0
            )
    }
}
