package scoop.grid

import scoop.collections.HashMap
import scoop.collections.HashSet
import scoop.ui.*
import scoop.ui.component.*
import scoop.window.accessibility.*
import scoop.ui.component.row as columnsRow
import scoop.ui.component.checkbox as columnsCheckbox
import scoop.ui.component.button as columnsButton

internal class GridColumnChoices<Row>(
    val input: GridColumnsPanelProps<Row>,
    val entries: Array<GridColumnState>,
    val selected: GridColumnId,
    val appearance: GridAppearance,
    val enabled: Boolean,
    private val choose: (GridColumnId) -> Boolean,
    private val show: (GridColumnId, Boolean) -> Unit
): ItemSource {
    private val positions = HashMap<GridColumnId, Long>()
    private val filtered = HashSet<GridColumnId>()
    private val sorting = HashMap<GridColumnId, String>()
    private val titles =
        Array<String>(entries.size) { index -> input.state.column(entries[index].id).title }
    init {
        for (index in 0L ..< entries.size)
            positions.put(entries[index].id, index)
        collectGridFilterColumns(input.state.query.filter, filtered)
        val sorts = input.state.query.sorting
        for (index in 0L ..< sorts.size) {
            val direction =
                if (sorts[index].direction == GridSortDirection.Ascending)
                    "↑"
                else
                    "↓"
            sorting.put(sorts[index].column, f"排序 ${index + 1L}${direction}")
        }
    }
    public override val count: Long get() = entries.size
    public override fun keyAt(index: Long): ViewKey = ViewKey.Text(entries[index].id.value)
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Text(val id) -> if (id == "")
                None
            else
                positions[GridColumnId(id)]
            else -> None
        }
    private fun caption(id: GridColumnId): String {
        var text = titles[positions[id]!!]
        when (val sort = sorting[id]) {
            case Some(val label) -> text += f" · ${label}";
            case None -> {}
        }
        if (id in filtered)
            text += " · 筛选中"
        return text
    }
    private fun visible(id: GridColumnId): Boolean {
        val states = input.state.columnState
        val index = gridColumnStateIndex(states, id) ?: return false
        return states[index].visible
    }
    public override fun build(index: Long): View {
        val entry = entries[index]
        val title = titles[index]
        val source = this
        return columnsRow {
            add(
                columnsCheckbox(
                    binding(
                        { source.visible(entry.id) },
                        { visible -> source.show(entry.id, visible) }
                    )
                ) {
                    enabled = source.enabled
                    theme = source.input.theme
                    semantics = gridColumnControl(entry.id, "visible", f"显示 ${title} 列")
                }
            )
            item(
                columnsButton(
                    source.caption(entry.id),
                    {
                        source.choose(entry.id);
                        Unit
                    }
                ) {
                    enabled = source.enabled
                    variant =
                        if (entry.id == source.selected)
                            ButtonVariant.Secondary
                        else
                            ButtonVariant.Ghost
                    fonts = source.input.fonts
                    theme = source.input.theme
                    semantics = gridColumnControl(entry.id, "choose", f"设置 ${title} 列")
                }
            ) { grow = 1.0 }
            spacing = 6.0 * source.appearance.density
            alignment = CrossAlignment.Center
        }
    }
    fun semantics(): ItemSemantics =
        ItemSemantics(
            this,
            {
                index ->
                val entry = entries[index]
                Some(
                    SemanticItemProperties(
                        name = Some(caption(entry.id)),
                        automationId = Some(f"grid-columns-${entry.id.value}-item"),
                        enabled = enabled,
                        selected = Some(entry.id == selected),
                        focusable = true
                    )
                )
            },
            search = SemanticItemSearch(name = true, automationId = true),
            selection = Some(SemanticCollectionSelection([SemanticItemKey.Text(selected.value)])),
            setSelected =
                Some {
                    key,
                    checked -> if (!enabled || !checked)
                        SemanticActionResult.Rejected
                    else
                        when (key) {
                            case Text(val id) -> if (id != "" && choose(GridColumnId(id)))
                                SemanticActionResult.Completed
                            else
                                SemanticActionResult.Unavailable
                            else -> SemanticActionResult.InvalidArgument
                        }
                }
        )
}

private fun collectGridFilterColumns(filter: GridFilter, result: HashSet<GridColumnId>) {
    when (filter) {
        case All -> {}
        case Column(val id, _) -> {
            result.add(id);
            Unit
        }
        case And(val children) -> for (child in children)
            collectGridFilterColumns(child, result)
        case Or(val children) -> for (child in children)
            collectGridFilterColumns(child, result)
    }
}
