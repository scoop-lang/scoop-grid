package scoop.grid

import scoop.collections.HashSet
import scoop.collections.HashMap
import scoop.ui.state
import scoop.ui.ViewKey
import scoop.ui.component.TableSource
import scoop.ui.component.CheckState

public class DataGridState<Row> public constructor(
    source: TableSource<Row>,
    columns: Array<GridColumn<Row>>,
    query: GridQuery = GridQuery(),
    public val onQueryChange: ((GridQuery) -> Unit)? = None,
    headers: Array<GridHeaderNode>? = None,
    pinnedRows: GridPinnedRows = GridPinnedRows(),
    public val rowSelection: GridRowSelectionMode = GridRowSelectionMode.Disabled,
    private val selectable: ((Row) -> Boolean)? = None,
    public val onSelectionChange: ((Array<ViewKey>) -> Unit)? = None
) {
    private val computed =
        state(
            gridCompute(
                source,
                GridColumns(columns),
                query,
                None,
                gridCheckPinnedRows(source, pinnedRows)
            )
        )
    private val headerState =
        state(
            GridHeaders(Array<GridColumnId>(columns.size) { index -> columns[index].id }, headers)
        )
    private val presentation =
        state(
            Array<GridColumnState>(columns.size) {
                index -> GridColumnState(headerState.value.leaves[index])
            }
        )
    private val observers = ArrayList<GridModelObserver>()
    private val filterCandidates = HashMap<GridColumnId, GridFilterValues>()
    private val selection = state(GridSelectedRows([]))
    private val rangeSelection = state<GridCellRange?>(None)
    private var rangeColumns: GridSpanColumns? = None
    private var selectionAnchor: ViewKey? = None
    private var selectablePage: GridSelectablePage<Row>? = None
    internal val selectedRows: GridSelectedRows get() = selection.value
    public val selectedRowKeys: Array<ViewKey> get() = selection.value.keys
    public fun isRowSelected(key: ViewKey): Boolean = selection.value.contains(key)
    internal fun acceptsRow(row: Row): Boolean = selectable?.invoke(row) ?: true
    public fun isRowSelectable(key: ViewKey): Boolean {
        if (rowSelection == GridRowSelectionMode.Disabled)
            return false
        val index = source.indexOfKey(key) ?: return false
        return selectable?.invoke(source.rowAt(index)) ?: true
    }
    public fun setSelectedRows(keys: Array<ViewKey>) {
        selection.checkMutation()
        gridRequire(
            rowSelection != GridRowSelectionMode.Disabled || keys.size == 0L,
            "row selection is disabled"
        )
        gridRequire(
            rowSelection != GridRowSelectionMode.Single || keys.size <= 1L,
            "single row selection has multiple keys"
        )
        val next = GridSelectedRows(keys)
        for (key in keys)
            gridRequire(isRowSelectable(key), "selected row is absent or not selectable")
        selectionAnchor = None
        publishSelection(next)
    }
    public fun setRowSelected(key: ViewKey, value: Boolean, extend: Boolean = false): Boolean {
        selection.checkMutation()
        gridRequire(key != ViewKey.Position, "row selection requires an explicit key")
        if (rowSelection == GridRowSelectionMode.Disabled || source.indexOfKey(key) == None)
            return false
        if (value && !isRowSelectable(key))
            return false
        if (extend && rowSelection == GridRowSelectionMode.Multiple) {
            when (selectionAnchor) {
                case Some(val anchor) -> if (
                    result.rows.indexOfKey(anchor) != None && result.rows.indexOfKey(key) != None
                )
                    return selectRowRange(anchor, key, value)
                case None -> {}
            }
        }
        selectionAnchor = Some(key)
        val next = ArrayList<ViewKey>()
        if (!value || rowSelection == GridRowSelectionMode.Multiple)
            for (old in selection.value.keys)
                if (old != key)
                    next.add(old)
        if (value)
            next.add(key)
        publishSelection(GridSelectedRows(next.toArray()))
        return true
    }
    public fun clearRowSelection() {
        selection.checkMutation()
        selectionAnchor = None
        publishSelection(GridSelectedRows([]))
    }
    public fun selectRowRange(anchor: ViewKey, end: ViewKey, value: Boolean = true): Boolean {
        selection.checkMutation()
        if (rowSelection != GridRowSelectionMode.Multiple)
            return false
        val rows = result.rows
        val first = rows.indexOfKey(anchor) ?: return false
        val last = rows.indexOfKey(end) ?: return false
        val start =
            if (first < last)
                first
            else
                last
        val stop =
            if (first < last)
                last
            else
                first
        val targeted = HashSet<ViewKey>()
        val keys = ArrayList<ViewKey>()
        for (index in start .. stop) {
            val key = rows.keyAt(index)
            if (isRowSelectable(key)) {
                targeted.add(key)
                keys.add(key)
            }
        }
        changeSelection(targeted, keys.toArray(), value)
        return true
    }
    public fun selectPageRows(value: Boolean): Boolean {
        selection.checkMutation()
        if (rowSelection != GridRowSelectionMode.Multiple)
            return false
        val rows = result.pageRows
        val targeted = HashSet<ViewKey>()
        val keys = ArrayList<ViewKey>()
        for (index in 0L ..< rows.count) {
            val key = rows.keyAt(index)
            if (isRowSelectable(key)) {
                targeted.add(key)
                keys.add(key)
            }
        }
        changeSelection(targeted, keys.toArray(), value)
        selectionAnchor = None
        return true
    }
    private fun changeSelection(targeted: HashSet<ViewKey>, keys: Array<ViewKey>, value: Boolean) {
        val next = ArrayList<ViewKey>()
        for (old in selection.value.keys)
            if (value || !targeted.contains(old))
                next.add(old)
        if (value)
            for (key in keys)
                if (!selection.value.contains(key))
                    next.add(key)
        publishSelection(GridSelectedRows(next.toArray()))
    }
    private fun publishSelection(next: GridSelectedRows) {
        if (selection.value.same(next))
            return
        selection.value = next
        onSelectionChange?.invoke(next.keys)
    }
    public val pageSelectableRows: Long get() {
        if (rowSelection == GridRowSelectionMode.Disabled)
            return 0L
        val rows = result.pageRows
        val test = selectable ?: return rows.count
        when (selectablePage) {
            case Some(val cached) -> if (cached.source === rows)
                return cached.count
            case None -> {}
        }
        var total = 0L
        for (index in 0L ..< rows.count)
            if (test(rows.rowAt(index)))
                total += 1L
        selectablePage = Some(GridSelectablePage(rows, total))
        return total
    }
    public val pageRowSelection: CheckState get() {
        val total = pageSelectableRows
        val rows = result.pageRows
        var count = 0L
        for (key in selection.value.keys)
            if (rows.indexOfKey(key) != None)
                count += 1L
        return gridSelectionState(count, total)
    }
    public val cellRange: GridCellRange? get() = rangeSelection.value
    public fun setCellRange(value: GridCellRange?): Boolean {
        rangeSelection.checkMutation()
        when (value) {
            case Some(val range) -> when (gridCellRangeBounds(range, result.rows, cellColumns())) {
                case Some(_) -> {}
                case None -> return false
            }
            case None -> {}
        }
        rangeSelection.value = value
        return true
    }
    public fun clearCellRange() {
        rangeSelection.value = None
    }
    public fun isCellInRange(address: GridCellAddress): Boolean {
        val range = cellRange ?: return false
        val rows = result.rows
        val columns = cellColumns()
        val bounds = gridCellRangeBounds(range, rows, columns) ?: return false
        val row = rows.indexOfKey(address.row) ?: return false
        val column = columns.indexOf(address.column) ?: return false
        return bounds.contains(row, column)
    }
    internal val cellRangeBounds: GridCellRangeBounds? get() =
        when (cellRange) {
            case Some(val range) -> gridCellRangeBounds(range, result.rows, cellColumns())
            case None -> None
        }
    private fun cellColumns(): GridSpanColumns {
        val states = columnState
        when (rangeColumns) {
            case Some(val old) -> if (old.states === states)
                return old
            case None -> {}
        }
        val next = GridSpanColumns(states)
        rangeColumns = Some(next)
        return next
    }
    public fun copyText(
        fallback: GridCellAddress? = None,
        includeHeaders: Boolean = false
    ): String? {
        val snapshot = computed.value
        val order = cellColumns()
        val range =
            cellRange ?:
                when (fallback) {
                    case Some(val address) -> GridCellRange(address, address)
                    case None -> return None
                }
        val bounds = gridCellRangeBounds(range, snapshot.result.rows, order) ?: return None
        val columns =
            Array<GridColumn<Row>>(bounds.lastColumn - bounds.firstColumn + 1L) {
                index -> snapshot.columns.get(order.idAt(bounds.firstColumn + index))
            }
        return Some(gridCopyText(snapshot.result.rows, columns, bounds, includeHeaders))
    }
    public val query: GridQuery get() = computed.value.query
    public fun findCell(
        text: String,
        after: GridCellAddress? = None,
        backwards: Boolean = false,
        matchCase: Boolean = false,
        wrap: Boolean = true
    ): GridFindMatch? {
        val snapshot = computed.value
        return gridFindCell(
            snapshot.result.rows,
            snapshot.columns,
            columnState,
            text,
            after,
            backwards,
            matchCase,
            wrap
        )
    }
    public fun exportCsv(options: GridCsvOptions = GridCsvOptions()): String =
        gridExportCsv(computed.value, columnState, selectedRows, options)
    public val result: GridResult<Row> get() = computed.value.result
    public val pinnedRows: GridPinnedRows get() = computed.value.pins
    public val columns: Array<GridColumn<Row>> get() = computed.value.columns.values
    public val columnState: Array<GridColumnState> get() = presentation.value
    public val headers: Array<GridHeaderNode> get() = headerState.value.values
    internal val headerTree: GridHeaders get() = headerState.value
    public fun column(id: GridColumnId): GridColumn<Row> = computed.value.columns.get(id)
    public fun filterValues(id: GridColumnId): GridFilterValues {
        computed.checkMutation()
        val definition = column(id)
        gridRequire(definition.filterable, "grid column is not filterable")
        when (filterCandidates[id]) {
            case Some(val values) -> return values
            case None -> {}
        }
        val values = collectGridFilterValues(source, definition)
        filterCandidates.put(id, values)
        return values
    }
    internal fun filterValuesCurrent(id: GridColumnId, values: GridFilterValues): Boolean {
        computed.value
        return when (filterCandidates[id]) {
            case Some(val current) -> current === values
            case None -> false
        }
    }
    internal val source: TableSource<Row> get() = computed.value.source
    internal fun findColumn(id: GridColumnId): GridColumn<Row>? = computed.value.columns.find(id)
    internal fun visibleColumn(id: GridColumnId): Boolean {
        for (column in presentation.value)
            if (column.id == id)
                return column.visible
        return false
    }
    internal fun observe(action: () -> Unit): Closeable {
        val observer = GridModelObserver(action, { value -> removeObserver(value) })
        observers.add(observer)
        return observer
    }
    private fun removeObserver(value: GridModelObserver) {
        for (index in 0L ..< observers.size)
            if (observers[index] === value) {
                observers.removeAt(index)
                return
            }
    }
    private fun changed() {
        for (observer in observers.toArray())
            if (!observer.closed)
                observer.action()
    }

    public fun setQuery(value: GridQuery) {
        computed.checkMutation()
        val old = computed.value
        val requested =
            if (gridCriteriaEqual(old.query, value))
                value
            else
                value.withPagination(gridFirstPage(value.pagination))
        if (old.query == requested)
            return
        val next = gridCompute(old.source, old.columns, requested, Some(old), old.pins)
        computed.value = next
        if (old.query != next.query)
            clearCellRange()
        notify(old.query, next.query)
    }
    public fun setPage(index: Long) {
        when (query.pagination) {
            case Page(_, val size) -> setQuery(
                query.withPagination(GridPagination.Page(index, size))
            )
            case Disabled -> throw IllegalArgumentException(Some("pagination is disabled"))
        }
    }
    public fun setPagination(value: GridPagination) {
        setQuery(query.withPagination(value))
    }
    public fun toggleSort(id: GridColumnId, additive: Boolean = false) {
        gridRequire(column(id).sortable, "grid column is not sortable")
        val sorting = ArrayList<GridSort>()
        var found = false
        for (sort in query.sorting) {
            if (sort.column == id) {
                found = true
                if (sort.direction == GridSortDirection.Ascending)
                    sorting.add(GridSort(id, GridSortDirection.Descending))
            } else
                if (additive)
                    sorting.add(sort)
        }
        if (!found)
            sorting.add(GridSort(id))
        setQuery(GridQuery(sorting.toArray(), query.filter, query.quickFilter, query.pagination))
    }
    public fun replaceData(source: TableSource<Row>) {
        computed.checkMutation()
        val old = computed.value
        if (source === old.source)
            return
        val next =
            gridCompute(source, old.columns, old.query, Some(old), old.pins.surviving(source))
        val kept = gridSurvivingSelection(selection.value, source, selectable)
        val keepRange =
            cellRange ==
                None ||
                (old.query == next.query && gridSameCellRows(old.result.rows, next.result.rows))
        filterCandidates.clear()
        computed.value = next
        if (!keepRange)
            clearCellRange()
        publishSelection(kept)
        when (selectionAnchor) {
            case Some(val key) -> if (source.indexOfKey(key) == None)
                selectionAnchor = None
            case None -> {}
        }
        notify(old.query, next.query)
    }
    public fun replaceColumns(
        values: Array<GridColumn<Row>>,
        headers: Array<GridHeaderNode>? = None
    ) {
        computed.checkMutation()
        val old = computed.value
        val nextColumns = GridColumns(values)
        val ids = Array<GridColumnId>(values.size) { index -> values[index].id }
        val nextHeaders = GridHeaders(ids, Some(headers ?: headerTree.surviving(ids)))
        val sorting = ArrayList<GridSort>()
        for (sort in old.query.sorting)
            if (nextColumns.contains(sort.column))
                sorting.add(sort)
        val filter = gridSurvivingFilter(old.query.filter, nextColumns) ?: GridFilter.All
        val requested =
            GridQuery(sorting.toArray(), filter, old.query.quickFilter, old.query.pagination)
        val next = gridCompute(old.source, nextColumns, requested, None, old.pins)
        val states = ArrayList<GridColumnState>()
        val retained = HashSet<GridColumnId>()
        for (entry in presentation.value)
            when (nextColumns.find(entry.id)) {
                case Some(val column) -> {
                    val width =
                        when (entry.width) {
                            case Some(val value) -> Some(column.size.constrain(value))
                            case None -> None
                        }
                    states.add(GridColumnState(entry.id, entry.visible, width, entry.pin))
                    retained.add(entry.id)
                }
                case None -> {}
            }
        for (column in values)
            if (!retained.contains(column.id))
                states.add(GridColumnState(column.id))
        val nextStates =
            when (headers) {
                case Some(_) -> {
                    val byId = HashMap<GridColumnId, GridColumnState>()
                    for (entry in states)
                        byId.put(entry.id, entry)
                    Array<GridColumnState>(values.size) { at -> byId[nextHeaders.leaves[at]]!! }
                }
                case None -> states.toArray()
            }
        val keepRange =
            cellRange ==
                None ||
                (
                    old.query ==
                        next.query &&
                        gridSameCellColumns(presentation.value, nextStates) &&
                        gridSameCellRows(old.result.rows, next.result.rows)
                )
        filterCandidates.clear()
        headerState.value = nextHeaders
        presentation.value = nextStates
        computed.value = next
        if (!keepRange)
            clearCellRange()
        notify(old.query, next.query)
    }
    public fun setColumnState(value: GridColumnState) {
        presentation.checkMutation()
        column(value.id)
        setColumnStates(
            Array<GridColumnState>(presentation.value.size) {
                index ->
                val old = presentation.value[index]
                if (old.id == value.id)
                    value
                else
                    old
            }
        )
    }
    public fun setPinnedRows(value: GridPinnedRows) {
        computed.checkMutation()
        val old = computed.value
        if (old.pins.same(value))
            return
        gridCheckPinnedRows(old.source, value)
        val before = old.result
        val result =
            gridPinResult(
                before.pageRows,
                before.ordered,
                before.totalRows,
                before.pageCount,
                value
            )
        computed.value = GridComputed(old.source, old.columns, old.query, result, value)
        clearCellRange()
        changed()
    }
    public fun pinRow(key: ViewKey, pin: GridRowPin) {
        computed.checkMutation()
        gridRequire(
            key != ViewKey.Position && source.indexOfKey(key) != None,
            "unknown fixed row key"
        )
        setPinnedRows(pinnedRows.moved(key, pin))
    }
    public fun setColumnStates(values: Array<GridColumnState>) {
        presentation.checkMutation()
        val definitions = computed.value.columns
        gridRequire(
            values.size == definitions.values.size,
            "column state must include every column"
        )
        val seen = HashSet<GridColumnId>()
        val next =
            Array<GridColumnState>(values.size) {
                index ->
                val entry = values[index]
                val definition = definitions.get(entry.id)
                gridRequire(seen.add(entry.id), "duplicate column state")
                val width =
                    when (entry.width) {
                        case Some(val amount) -> Some(definition.size.constrain(amount))
                        case None -> None
                    }
                GridColumnState(entry.id, entry.visible, width, entry.pin)
            }
        when (val error = headerTree.orderError(next)) {
            case Some(val message) -> throw IllegalArgumentException(Some(message))
            case None -> {}
        }
        if (gridArrayEqual(presentation.value, next))
            return
        val keepRange = cellRange == None || gridSameCellColumns(presentation.value, next)
        presentation.value = next
        if (!keepRange)
            clearCellRange()
        changed()
    }
    public fun moveColumn(id: GridColumnId, index: Long) {
        moveHeader(GridHeaderKey.Column(id), index)
    }
    public fun moveColumnGroup(id: GridColumnGroupId, index: Long) {
        moveHeader(GridHeaderKey.Group(id), index)
    }
    private fun moveHeader(key: GridHeaderKey, index: Long) {
        presentation.checkMutation()
        when (val move = headerTree.relocate(presentation.value, key, index)) {
            case Ready(val next) -> {
                if (next === presentation.value)
                    return
                val keepRange = cellRange == None || gridSameCellColumns(presentation.value, next)
                presentation.value = next
                if (!keepRange)
                    clearCellRange()
                changed()
            }
            case Rejected(val message) -> throw IllegalArgumentException(Some(message))
        }
    }
    private fun notify(old: GridQuery, next: GridQuery) {
        changed()
        if (old == next)
            return
        when (onQueryChange) {
            case Some(val action) -> action(next);
            case None -> {}
        }
    }
}

private class GridModelObserver(
    val action: () -> Unit,
    private val remove: (GridModelObserver) -> Unit
): Closeable {
    var closed = false
    public override fun close() {
        if (closed)
            return
        closed = true
        remove(this)
    }
}
