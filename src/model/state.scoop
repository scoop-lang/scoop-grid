package scoop.grid

import scoop.collections.HashSet
import scoop.collections.HashMap
import scoop.ui.state
import scoop.ui.component.TableSource

public class DataGridState<Row> public constructor(
    source: TableSource<Row>,
    columns: Array<GridColumn<Row>>,
    query: GridQuery = GridQuery(),
    public val onQueryChange: ((GridQuery) -> Unit)? = None
) {
    private val computed = state(gridCompute(source, GridColumns(columns), query, None))
    private val presentation =
        state(Array<GridColumnState>(columns.size) { index -> GridColumnState(columns[index].id) })
    private val observers = ArrayList<GridModelObserver>()
    private val filterCandidates = HashMap<GridColumnId, GridFilterValues>()
    public val query: GridQuery get() = computed.value.query
    public val result: GridResult<Row> get() = computed.value.result
    public val columns: Array<GridColumn<Row>> get() = computed.value.columns.values
    public val columnState: Array<GridColumnState> get() = presentation.value
    public fun column(id: GridColumnId): GridColumn<Row> = computed.value.columns.get(id)
    public fun filterValues(id: GridColumnId): GridFilterValues {
        computed.checkMutation()
        val definition = column(id)
        gridRequire(definition.filterable, "grid column is not filterable")
        when (filterCandidates[id]) {
            case Some(val values) -> return values
            case None -> {}
        }
        val values = collectGridFilterValues(source, definition)
        filterCandidates.put(id, values)
        return values
    }
    internal fun filterValuesCurrent(id: GridColumnId, values: GridFilterValues): Boolean {
        computed.value
        return when (filterCandidates[id]) {
            case Some(val current) -> current === values
            case None -> false
        }
    }
    internal val source: TableSource<Row> get() = computed.value.source
    internal fun findColumn(id: GridColumnId): GridColumn<Row>? = computed.value.columns.find(id)
    internal fun visibleColumn(id: GridColumnId): Boolean {
        for (column in presentation.value)
            if (column.id == id)
                return column.visible
        return false
    }
    internal fun observe(action: () -> Unit): Closeable {
        val observer = GridModelObserver(action, { value -> removeObserver(value) })
        observers.add(observer)
        return observer
    }
    private fun removeObserver(value: GridModelObserver) {
        for (index in 0L ..< observers.size)
            if (observers[index] === value) {
                observers.removeAt(index)
                return
            }
    }
    private fun changed() {
        for (observer in observers.toArray())
            if (!observer.closed)
                observer.action()
    }

    public fun setQuery(value: GridQuery) {
        computed.checkMutation()
        val old = computed.value
        val requested =
            if (gridCriteriaEqual(old.query, value))
                value
            else
                value.withPagination(gridFirstPage(value.pagination))
        if (old.query == requested)
            return
        val next = gridCompute(old.source, old.columns, requested, Some(old))
        computed.value = next
        notify(old.query, next.query)
    }
    public fun setPage(index: Long) {
        when (query.pagination) {
            case Page(_, val size) -> setQuery(
                query.withPagination(GridPagination.Page(index, size))
            )
            case Disabled -> throw IllegalArgumentException(Some("pagination is disabled"))
        }
    }
    public fun setPagination(value: GridPagination) {
        setQuery(query.withPagination(value))
    }
    public fun toggleSort(id: GridColumnId, additive: Boolean = false) {
        gridRequire(column(id).sortable, "grid column is not sortable")
        val sorting = ArrayList<GridSort>()
        var found = false
        for (sort in query.sorting) {
            if (sort.column == id) {
                found = true
                if (sort.direction == GridSortDirection.Ascending)
                    sorting.add(GridSort(id, GridSortDirection.Descending))
            } else
                if (additive)
                    sorting.add(sort)
        }
        if (!found)
            sorting.add(GridSort(id))
        setQuery(GridQuery(sorting.toArray(), query.filter, query.quickFilter, query.pagination))
    }
    public fun replaceData(source: TableSource<Row>) {
        computed.checkMutation()
        val old = computed.value
        if (source === old.source)
            return
        val next = gridCompute(source, old.columns, old.query, Some(old))
        filterCandidates.clear()
        computed.value = next
        notify(old.query, next.query)
    }
    public fun replaceColumns(values: Array<GridColumn<Row>>) {
        computed.checkMutation()
        val old = computed.value
        val nextColumns = GridColumns(values)
        val sorting = ArrayList<GridSort>()
        for (sort in old.query.sorting)
            if (nextColumns.contains(sort.column))
                sorting.add(sort)
        val filter = gridSurvivingFilter(old.query.filter, nextColumns) ?: GridFilter.All
        val requested =
            GridQuery(sorting.toArray(), filter, old.query.quickFilter, old.query.pagination)
        val next = gridCompute(old.source, nextColumns, requested, None)
        val states = ArrayList<GridColumnState>()
        val retained = HashSet<GridColumnId>()
        for (entry in presentation.value)
            when (nextColumns.find(entry.id)) {
                case Some(val column) -> {
                    val width =
                        when (entry.width) {
                            case Some(val value) -> Some(column.size.constrain(value))
                            case None -> None
                        }
                    states.add(GridColumnState(entry.id, entry.visible, width, entry.pin))
                    retained.add(entry.id)
                }
                case None -> {}
            }
        for (column in values)
            if (!retained.contains(column.id))
                states.add(GridColumnState(column.id))
        filterCandidates.clear()
        presentation.value = states.toArray()
        computed.value = next
        notify(old.query, next.query)
    }
    public fun setColumnState(value: GridColumnState) {
        presentation.checkMutation()
        column(value.id)
        setColumnStates(
            Array<GridColumnState>(presentation.value.size) {
                index ->
                val old = presentation.value[index]
                if (old.id == value.id)
                    value
                else
                    old
            }
        )
    }
    public fun setColumnStates(values: Array<GridColumnState>) {
        presentation.checkMutation()
        val definitions = computed.value.columns
        gridRequire(
            values.size == definitions.values.size,
            "column state must include every column"
        )
        val seen = HashSet<GridColumnId>()
        val next =
            Array<GridColumnState>(values.size) {
                index ->
                val entry = values[index]
                val definition = definitions.get(entry.id)
                gridRequire(seen.add(entry.id), "duplicate column state")
                val width =
                    when (entry.width) {
                        case Some(val amount) -> Some(definition.size.constrain(amount))
                        case None -> None
                    }
                GridColumnState(entry.id, entry.visible, width, entry.pin)
            }
        if (gridArrayEqual(presentation.value, next))
            return
        presentation.value = next
        changed()
    }
    public fun moveColumn(id: GridColumnId, index: Long) {
        presentation.checkMutation()
        column(id)
        val old = presentation.value
        gridRequire(index >= 0L && index < old.size, "grid column destination is out of range")
        val others = ArrayList<GridColumnState>()
        var moving: GridColumnState? = None
        for (item in old)
            if (item.id == id)
                moving = Some(item)
            else
                others.add(item)
        val entry =
            moving ?: throw IllegalArgumentException(Some("grid column has no presentation state"))
        val next =
            Array<GridColumnState>(old.size) {
                at -> if (at == index)
                    entry
                else
                    others[
                        if (at < index)
                            at
                        else
                            at - 1L
                    ]
            }
        if (gridArrayEqual(old, next))
            return
        presentation.value = next
        changed()
    }
    private fun notify(old: GridQuery, next: GridQuery) {
        changed()
        if (old == next)
            return
        when (onQueryChange) {
            case Some(val action) -> action(next);
            case None -> {}
        }
    }
}

private class GridModelObserver(
    val action: () -> Unit,
    private val remove: (GridModelObserver) -> Unit
): Closeable {
    var closed = false
    public override fun close() {
        if (closed)
            return
        closed = true
        remove(this)
    }
}
