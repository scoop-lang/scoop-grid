package scoop.grid

import scoop.graphics.text.*
import scoop.math.BigDecimal
import scoop.ui.*
import scoop.ui.component.TableColumnSize
import scoop.ui.component.Label
import scoop.ui.component.LabelProps
import scoop.ui.component.LabelText

public interface GridColumn<Row> {
    public val id: GridColumnId
    public val title: String
    public val size: TableColumnSize
    public val sortable: Boolean
    public val filterable: Boolean
    public val valueKind: GridValueKind?
    public val exportable: Boolean
    public val missingLast: Boolean
    public val editing: GridColumnEditing<Row>?
    public val aggregations: Array<GridColumnAggregation<Row>> get() = []
    public fun cell(
        row: Row,
        fonts: FontCollection? = None,
        style: TextStyle? = None,
        paragraph: ParagraphStyle? = None
    ): View
    public fun text(row: Row): String?
    public fun number(row: Row): Double?
    public fun numericValue(row: Row): BigDecimal? =
        when (number(row)) {
            case Some(val value) -> Some(BigDecimal.fromDouble(value))
            case None -> None
        }
    public fun missing(row: Row): Boolean
    public fun compare(left: Row, right: Row): Long
    public fun predicate(condition: GridCondition): (Row) -> Boolean
    public fun filterValue(row: Row): GridFilterValue
}

public fun <Row, T> gridColumn(
    id: GridColumnId,
    title: String,
    value: (Row) -> T,
    values: GridValues<T>,
    size: TableColumnSize = TableColumnSize(),
    cell: ((Row) -> View)? = None,
    sortable: Boolean = true,
    filterable: Boolean = true,
    exportable: Boolean = true,
    missingLast: Boolean = true,
    edit: GridEditSpec<Row, T>? = None,
    aggregations: Array<GridAggregation<T>> = []
): GridColumn<Row> =
    TypedGridColumn(
        id,
        title,
        value,
        values,
        size,
        cell,
        sortable,
        filterable,
        exportable,
        missingLast,
        edit,
        aggregations
    )

private class TypedGridColumn<Row, T>(
    public override val id: GridColumnId,
    public override val title: String,
    private val value: (Row) -> T,
    private val values: GridValues<T>,
    public override val size: TableColumnSize,
    private val render: ((Row) -> View)?,
    public override val sortable: Boolean,
    public override val filterable: Boolean,
    public override val exportable: Boolean,
    public override val missingLast: Boolean,
    edit: GridEditSpec<Row, T>?,
    operations: Array<GridAggregation<T>>
): GridColumn<Row> {
    public override val valueKind: GridValueKind? get() = Some(values.kind)
    public override val editing: GridColumnEditing<Row>? = edit?.bind(value)
    public override val aggregations: Array<GridColumnAggregation<Row>> =
        Array<GridColumnAggregation<Row>>(operations.size) {
            index -> gridBindAggregation(value, values.missing, operations[index])
        }
    public override fun numericValue(row: Row): BigDecimal? {
        val current = value(row)
        if (values.missing(current))
            return None
        if (values.kind == GridValueKind.Integer || values.kind == GridValueKind.Number) {
            return when (values.encode(current)) {
                case Integer(val number) -> Some(BigDecimal(number))
                case Number(val number) -> Some(BigDecimal.fromDouble(number))
                case Empty -> None
                else -> throw IllegalArgumentException(
                    Some("numeric column requires a numeric literal")
                )
            }
        }
        return when (values.number(current)) {
            case Some(val number) -> Some(BigDecimal.fromDouble(number))
            case None -> None
        }
    }
    public override fun cell(
        row: Row,
        fonts: FontCollection?,
        style: TextStyle?,
        paragraph: ParagraphStyle?
    ): View =
        when (render) {
            case Some(val build) -> build(row)
            case None -> component(
                LabelProps(
                    LabelText.Plain(values.format(value(row)), None),
                    fonts,
                    paragraph,
                    baseStyle = style
                ),
                { props, scope -> Label(props, scope) }
            )
        }
    public override fun text(row: Row): String? = Some(values.format(value(row)))
    public override fun number(row: Row): Double? = values.number(value(row))
    public override fun missing(row: Row): Boolean = values.missing(value(row))
    public override fun compare(left: Row, right: Row): Long {
        gridRequire(sortable, "grid column is not sortable")
        return values.compare(value(left), value(right))
    }
    public override fun predicate(condition: GridCondition): (Row) -> Boolean {
        gridRequire(filterable, "grid column is not filterable")
        val test = gridCondition(values, condition)
        val read = value
        return { row -> test(read(row)) }
    }
    public override fun filterValue(row: Row): GridFilterValue {
        gridRequire(filterable, "grid column is not filterable")
        val item = value(row)
        return GridFilterValue(values.encode(item), values.format(item))
    }
}

public fun <Row> gridActionColumn(
    id: GridColumnId,
    title: String,
    cell: (Row) -> View,
    size: TableColumnSize = TableColumnSize()
): GridColumn<Row> = ActionGridColumn(id, title, cell, size)

private class ActionGridColumn<Row>(
    public override val id: GridColumnId,
    public override val title: String,
    private val render: (Row) -> View,
    public override val size: TableColumnSize
): GridColumn<Row> {
    public override val sortable: Boolean get() = false
    public override val filterable: Boolean get() = false
    public override val valueKind: GridValueKind? get() = None
    public override val exportable: Boolean get() = false
    public override val missingLast: Boolean get() = true
    public override val editing: GridColumnEditing<Row>? get() = None
    public override fun cell(
        row: Row,
        fonts: FontCollection?,
        style: TextStyle?,
        paragraph: ParagraphStyle?
    ): View = render(row)
    public override fun text(row: Row): String? = None
    public override fun number(row: Row): Double? = None
    public override fun missing(row: Row): Boolean = true
    public override fun compare(left: Row, right: Row): Long =
        throw IllegalArgumentException(Some("action column is not sortable"))
    public override fun predicate(condition: GridCondition): (Row) -> Boolean =
        throw IllegalArgumentException(Some("action column is not filterable"))
    public override fun filterValue(row: Row): GridFilterValue =
        throw IllegalArgumentException(Some("action column is not filterable"))
}
