package scoop.grid

import scoop.collections.HashMap
import scoop.collections.sortWith
import scoop.comparisons.comparatorOf
import scoop.ui.ViewKey
import scoop.ui.component.TableSource

/** Fixed identities and omitted page positions stay sparse even for a huge source. */
internal fun <Row> gridPinResult(
    page: TableSource<Row>,
    ordered: TableSource<Row>,
    total: Long,
    pages: Long,
    pins: GridPinnedRows
): GridResult<Row> {
    val top = GridPickedRows(ordered, pins.top)
    val bottom = GridPickedRows(ordered, pins.bottom)
    if (top.count == 0L && bottom.count == 0L)
        return GridResult(page, page, ordered, total, pages, 0L, 0L)
    val omitted = ArrayList<Long>()
    for (fixed in [top, bottom])
        for (index in 0L ..< fixed.count)
            when (page.indexOfKey(fixed.keyAt(index))) {
                case Some(val at) -> omitted.add(at)
                case None -> {}
            }
    omitted.sortWith(comparatorOf<Long> { a, b -> a.compareTo(b) })
    val body =
        if (omitted.size == 0L)
            page
        else
            GridUnpinnedRows(page, omitted.toArray())
    val rows = GridPresentedRows(top, body, bottom)
    return GridResult(rows, page, ordered, total, pages, top.count, bottom.count)
}

private class GridPickedRows<Row>(
    private val source: TableSource<Row>,
    keys: Array<ViewKey>
): TableSource<Row> {
    private val indices = ArrayList<Long>()
    private val positions = HashMap<ViewKey, Long>()
    init {
        for (key in keys)
            when (source.indexOfKey(key)) {
                case Some(val at) -> {
                    positions.put(key, indices.size)
                    indices.add(at)
                }
                case None -> {}
            }
    }
    public override val count: Long get() = indices.size
    public override fun keyAt(index: Long): ViewKey = source.keyAt(indices[index])
    public override fun rowAt(index: Long): Row = source.rowAt(indices[index])
    public override fun indexOfKey(key: ViewKey): Long? = positions[key]
}

private class GridUnpinnedRows<Row>(
    private val source: TableSource<Row>,
    private val omitted: Array<Long>
): TableSource<Row> {
    public override val count: Long get() = source.count - omitted.size
    private fun sourceIndex(index: Long): Long {
        gridRequire(index >= 0L && index < count, "grid row index is out of range")
        var left = 0L
        var right = omitted.size
        while (left < right) {
            val middle = left + (right - left) / 2L
            if (omitted[middle] - middle <= index)
                left = middle + 1L
            else
                right = middle
        }
        return index + left
    }
    public override fun keyAt(index: Long): ViewKey = source.keyAt(sourceIndex(index))
    public override fun rowAt(index: Long): Row = source.rowAt(sourceIndex(index))
    public override fun indexOfKey(key: ViewKey): Long? {
        val at = source.indexOfKey(key) ?: return None
        var left = 0L
        var right = omitted.size
        while (left < right) {
            val middle = left + (right - left) / 2L
            if (omitted[middle] < at)
                left = middle + 1L
            else
                right = middle
        }
        return if (left < omitted.size && omitted[left] == at)
            None
        else
            Some(at - left)
    }
}

private class GridPresentedRows<Row>(
    private val top: TableSource<Row>,
    private val body: TableSource<Row>,
    private val bottom: TableSource<Row>
): TableSource<Row> {
    public override val count: Long get() = top.count + body.count + bottom.count
    private fun row(index: Long): (TableSource<Row>, Long) {
        gridRequire(index >= 0L && index < count, "grid row index is out of range")
        return if (index < top.count)
            (top, index)
        else
            if (index - top.count < body.count)
                (body, index - top.count)
            else
                (bottom, index - top.count - body.count)
    }
    public override fun keyAt(index: Long): ViewKey {
        val(source, at) = row(index)
        return source.keyAt(at)
    }
    public override fun rowAt(index: Long): Row {
        val(source, at) = row(index)
        return source.rowAt(at)
    }
    public override fun indexOfKey(key: ViewKey): Long? {
        when (val at = top.indexOfKey(key)) {
            case Some(_) -> return at
            case None -> {}
        }
        when (bottom.indexOfKey(key)) {
            case Some(val at) -> return Some(top.count + body.count + at)
            case None -> {}
        }
        return body.indexOfKey(key)?.plus(top.count)
    }
}
