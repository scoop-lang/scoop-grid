package scoop.grid

import scoop.math.BigDecimal
import scoop.ui.ViewKey
import scoop.ui.component.TableSource

public enum GridTotalKey: Equals<GridTotalKey>, Hash {
    AllFiltered, Group(GridGroupPath), Tree(ViewKey)
    public override operator fun equals(other: GridTotalKey): Boolean =
        when ((this, other)) {
            case(AllFiltered, AllFiltered) -> true
            case(Group(val a), Group(val b)) -> a == b
            case(Tree(val a), Tree(val b)) -> a == b
            else -> false
        }
    public override fun hash(): Long =
        when (this) {
            case AllFiltered -> 0L
            case Group(val path) -> path.hash() xor 1L
            case Tree(val key) -> key.hash() xor 2L
        }
}

public enum GridRowKey: Equals<GridRowKey>, Hash {
    Data(ViewKey), Group(GridGroupPath), Total(GridTotalKey), Detail(ViewKey), Unloaded(
        GridExternalPosition
    )
    public override operator fun equals(other: GridRowKey): Boolean =
        when ((this, other)) {
            case(Data(val a), Data(val b)) -> a == b
            case(Group(val a), Group(val b)) -> a == b
            case(Total(val a), Total(val b)) -> a == b
            case(Detail(val a), Detail(val b)) -> a == b
            case(Unloaded(val a), Unloaded(val b)) -> a == b
            else -> false
        }
    public override fun hash(): Long =
        when (this) {
            case Data(val key) -> key.hash() xor 1L
            case Group(val path) -> path.hash() xor 2L
            case Total(val key) -> key.hash() xor 3L
            case Detail(val key) -> key.hash() xor 4L
            case Unloaded(val position) -> position.hash() xor 5L
        }
    public val viewKey: ViewKey get() =
        when (this) {
            case Data(val key) -> when (key) {
                case Number(_) -> key
                case Text(val value) -> ViewKey.Text(f"d${value}")
                case Position -> throw IllegalArgumentException(
                    Some("grid row requires an explicit key")
                )
            }
            case Total(GridTotalKey.AllFiltered) -> ViewKey.Text("t:all")
            case Total(GridTotalKey.Group(val path)) -> ViewKey.Text(f"t:group${path.encoded}")
            case Total(GridTotalKey.Tree(val key)) -> when (key) {
                case Number(val value) -> ViewKey.Text(f"t:tree:n${value}")
                case Text(val value) -> ViewKey.Text(f"t:tree:s${value}")
                case Position -> throw IllegalArgumentException(
                    Some("tree totals require an explicit key")
                )
            }
            case Group(val path) -> ViewKey.Text(f"g${path.encoded}")
            case Detail(val key) -> when (key) {
                case Number(val value) -> ViewKey.Text(f"x:n${value}")
                case Text(val value) -> ViewKey.Text(f"x:t${value}")
                case Position -> throw IllegalArgumentException(
                    Some("details require an explicit parent key")
                )
            }
            case Unloaded(val position) -> ViewKey.Text(f"u${position.encoded}")
        }
    public val hasCells: Boolean get() =
        when (this) {
            case Detail(_) -> false
            case Unloaded(_) -> false
            else -> true
        }
    public val dataKey: ViewKey? get() =
        when (this) {
            case Data(val key) -> Some(key)
            else -> None
        }
}

public enum GridTotalPlacement: Equals<GridTotalPlacement> {
    Hidden, Before, After
    public override operator fun equals(other: GridTotalPlacement): Boolean =
        when ((this, other)) {
            case(Hidden, Hidden) -> true
            case(Before, Before) -> true
            case(After, After) -> true
            else -> false
        }
}

public struct GridTotals(
    val placement: GridTotalPlacement = GridTotalPlacement.Hidden,
    val label: String = "总计"
): Equals<GridTotals> {
    public override operator fun equals(other: GridTotals): Boolean =
        placement == other.placement && label == other.label
}

public class GridTotalRow internal constructor(
    public val key: GridTotalKey,
    public val label: String,
    public val aggregates: GridAggregations
)

/** Metadata access never materializes a business record. */
public enum GridRowInfo {
    Data(ViewKey), Group(GridGroupRow), Total(GridTotalRow), Detail(GridDetailRow), Unloaded(
        GridLoadRow
    )
    public val key: GridRowKey get() =
        when (this) {
            case Data(val key) -> GridRowKey.Data(key)
            case Group(val group) -> GridRowKey.Group(group.path)
            case Total(val total) -> GridRowKey.Total(total.key)
            case Detail(val detail) -> GridRowKey.Detail(detail.parent)
            case Unloaded(val load) -> GridRowKey.Unloaded(load.position)
        }
    public val dataKey: ViewKey? get() = key.dataKey
    public val label: String? get() =
        when (this) {
            case Data(_) -> None
            case Group(val group) -> Some(group.label)
            case Total(val total) -> Some(total.label)
            case Detail(val detail) -> Some(detail.label)
            case Unloaded(val load) -> Some(
                when (load.state) {
                    case Unloaded -> "尚未加载"
                    case Loading -> "正在加载…"
                    case Failed(val message) -> message
                }
            )
        }
}

public enum GridRow<Row> {
    Data(Row, ViewKey), Group(GridGroupRow), Total(GridTotalRow), Detail(
        Row,
        GridDetailRow
    ), Unloaded(GridLoadRow)
    public val info: GridRowInfo get() =
        when (this) {
            case Data(_, val key) -> GridRowInfo.Data(key)
            case Group(val group) -> GridRowInfo.Group(group)
            case Total(val total) -> GridRowInfo.Total(total)
            case Detail(_, val detail) -> GridRowInfo.Detail(detail)
            case Unloaded(val load) -> GridRowInfo.Unloaded(load)
        }
    public val key: GridRowKey get() = info.key
    public fun text(column: GridColumn<Row>, labelColumn: GridColumnId? = None): String? =
        when (this) {
            case Data(val row, _) -> column.text(row)
            case Detail(_, _) -> None
            case Unloaded(_) -> None
            case Group(val group) -> {
                val display = group.aggregates.total(column.id)
                val text = gridAggregateText(display)
                Some(
                    if (labelColumn == Some(column.id)) {
                        val label =
                            if (group.countKnown)
                                f"${group.label} (${group.count})"
                            else
                                group.label
                        if (text == "")
                            label
                        else
                            f"${label} · ${text}"
                    } else
                        text
                )
            }
            case Total(val total) -> Some(
                when (total.aggregates.total(column.id)) {
                    case Some(GridAggregateDisplay.Value(val text)) -> text
                    case Some(GridAggregateDisplay.Missing) -> ""
                    case Some(GridAggregateDisplay.Failed(val message)) -> message
                    case None -> if (labelColumn == Some(column.id))
                        total.label
                    else
                        ""
                }
            )
        }
    public fun numericValue(column: GridColumn<Row>): BigDecimal? =
        when (this) {
            case Data(val row, _) -> column.numericValue(row)
            case Group(val group) -> group.aggregates.numericTotal(column.id)
            case Total(val total) -> total.aggregates.numericTotal(column.id)
            case Detail(_, _) -> None
            case Unloaded(_) -> None
        }
    internal fun labelColumn(columns: Array<GridColumn<Row>>): GridColumnId? {
        return when (this) {
            case Data(_, _) -> None
            case Detail(_, _) -> None
            case Unloaded(_) -> None
            case Total(val total) -> gridRowLabelColumn(columns, total.aggregates)
            case Group(val group) -> {
                for (column in columns)
                    if (column.id == group.column)
                        return Some(column.id)
                when (val preferred = gridRowLabelColumn(columns, group.aggregates)) {
                    case Some(_) -> preferred
                    case None -> if (columns.size > 0L && columns[0L].id.isSource)
                        Some(columns[0L].id)
                    else
                        None
                }
            }
        }
    }
}

public interface GridRowSource<Row>: TableSource<GridRow<Row>> {
    public fun infoAt(index: Long): GridRowInfo
    public fun hierarchyAt(index: Long): GridRowHierarchy? = None
    /** Loaded sources are complete by default; sparse external sources report gaps without IO. */
    public fun unavailable(start: Long, count: Long): Array<GridExternalRange> = []
    public fun rowKeyAt(index: Long): GridRowKey = infoAt(index).key
    public fun indexOfKey(key: GridRowKey): Long? =
        when (key) {
            case Data(ViewKey.Position) -> None
            case Detail(ViewKey.Position) -> None
            else -> indexOfKey(key.viewKey)
        }
}

private fun gridAggregateText(value: GridAggregateDisplay?): String =
    when (value) {
        case Some(GridAggregateDisplay.Value(val text)) -> text
        case Some(GridAggregateDisplay.Failed(val message)) -> message
        else -> ""
    }

internal fun <Row> gridRowLabelColumn(
    columns: Array<GridColumn<Row>>,
    aggregates: GridAggregations
): GridColumnId? {
    for (column in columns)
        if (column.exportable)
            when (aggregates.total(column.id)) {
                case None -> return Some(column.id)
                case Some(_) -> {}
            }
    return None
}
