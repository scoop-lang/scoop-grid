package scoop.grid

import scoop.collections.HashSet

internal fun <Row> gridRestoreQuery(
    saved: GridQuery,
    columns: GridColumns<Row>,
    issues: ArrayList<GridRestoreIssue>,
    treeMode: Boolean = false,
    external: GridExternalSource<Row>? = None
): GridQuery {
    val sorting = ArrayList<GridSort>()
    val seen = HashSet<GridColumnId>()
    for (entry in saved.sorting) {
        val column = columns.find(entry.column)
        if (!seen.add(entry.column) || !(column?.sortable ?: false))
            issues.add(GridRestoreIssue(GridStatePart.Sorting(entry.column), "排序列重复、已移除或不可排序"))
        else
            sorting.add(entry)
    }
    val filter = gridRestoreFilter(saved.filter, columns, [], issues, external) ?: GridFilter.All
    var quickFilter = saved.quickFilter
    when (external) {
        case Some(val source) -> if (quickFilter != "" && !source.quickFilter) {
            quickFilter = ""
            issues.add(GridRestoreIssue(GridStatePart.QuickFilter, "外部来源未声明快速筛选"))
        }
        case None -> {}
    }
    val aggregations = ArrayList<GridAggregationSelection>()
    val metrics = HashSet<GridColumnId>()
    for (entry in saved.aggregations) {
        val definition = columns.find(entry.column)
        var allowed = false
        when (definition) {
            case Some(val column) -> when (gridFindAggregation(column, entry.operation)) {
                case Some(_) -> allowed = true
                case None -> {}
            }
            case None -> {}
        }
        if (!metrics.add(entry.column) || !allowed)
            issues.add(
                GridRestoreIssue(GridStatePart.Aggregation(entry.column), "聚合列重复、已移除或不再允许该操作")
            )
        else
            aggregations.add(entry)
    }
    val grouping =
        if (treeMode)
            []
        else
            gridSurvivingGrouping(saved.grouping, columns)
    val groupIds = HashSet<GridColumnId>()
    for (id in grouping)
        groupIds.add(id)
    val seenGroups = HashSet<GridColumnId>()
    for (id in saved.grouping)
        if (!seenGroups.add(id) || !groupIds.contains(id))
            issues.add(GridRestoreIssue(GridStatePart.Grouping(id), "分组列重复、已移除或不允许分组"))
    val groupSorting =
        gridSurvivingGroupSorting(saved.groupSorting, grouping, aggregations.toArray())
    val usedSorts = ArrayList<GridGroupSort>()
    for (sort in saved.groupSorting) {
        var valid = false
        for (kept in groupSorting)
            if (kept == sort)
                valid = true
        for (prior in usedSorts)
            if (prior.column == sort.column && prior.by == sort.by)
                valid = false
        if (valid)
            usedSorts.add(sort)
        else
            issues.add(GridRestoreIssue(GridStatePart.GroupSorting(sort.column), "组排序重复或其维度／度量已失效"))
    }
    return GridQuery(
        sorting.toArray(),
        filter,
        quickFilter,
        saved.pagination,
        aggregations.toArray(),
        saved.totals,
        grouping,
        groupSorting,
        saved.groupTotals,
        saved.treeTotals,
        gridRestorePivot(saved.pivot, columns, aggregations.toArray(), treeMode, issues)
    )
}

private fun <Row> gridRestoreFilter(
    value: GridFilter,
    columns: GridColumns<Row>,
    path: Array<Long>,
    issues: ArrayList<GridRestoreIssue>,
    external: GridExternalSource<Row>?
): GridFilter? =
    when (value) {
        case All -> Some(value)
        case Column(val id, val condition) -> {
            val definition = columns.find(id)
            if (!(definition?.filterable ?: false)) {
                issues.add(GridRestoreIssue(GridStatePart.Filter(path), "筛选列已移除或不可筛选"))
                None
            } else {
                try {
                    when (external) {
                        case Some(val source) -> {
                            val config = gridExternalFilter(source, id)
                            gridRequire(
                                gridAllowsFilter(
                                    config?.operations ?: [],
                                    gridFilterOperator(condition)
                                ),
                                "外部来源未声明该筛选操作"
                            )
                        }
                        case None -> {}
                    }
                    definition!!.predicate(condition)
                    Some(value)
                } catch (error: IllegalArgumentException) {
                    issues.add(
                        GridRestoreIssue(GridStatePart.Filter(path), error.message ?: "筛选条件与当前列不相容")
                    )
                    None
                }
            }
        }
        case And(val children) -> gridRestoreFilterChildren(
            children,
            columns,
            path,
            issues,
            true,
            external
        )
        case Or(val children) -> gridRestoreFilterChildren(
            children,
            columns,
            path,
            issues,
            false,
            external
        )
    }

private fun <Row> gridRestoreFilterChildren(
    children: Array<GridFilter>,
    columns: GridColumns<Row>,
    path: Array<Long>,
    issues: ArrayList<GridRestoreIssue>,
    conjunction: Boolean,
    external: GridExternalSource<Row>?
): GridFilter? {
    if (children.size == 0L) {
        issues.add(GridRestoreIssue(GridStatePart.Filter(path), "空筛选组已移除"))
        return None
    }
    val kept = ArrayList<GridFilter>()
    for (index in 0L ..< children.size) {
        val childPath =
            Array<Long>(path.size + 1L) {
                at -> if (at == path.size)
                    index
                else
                    path[at]
            }
        when (gridRestoreFilter(children[index], columns, childPath, issues, external)) {
            case Some(val child) -> kept.add(child)
            case None -> {}
        }
    }
    if (kept.size == 0L)
        return None
    return Some(
        if (conjunction)
            GridFilter.And(kept.toArray())
        else
            GridFilter.Or(kept.toArray())
    )
}

private fun <Row> gridRestorePivot(
    value: GridPivot?,
    columns: GridColumns<Row>,
    aggregations: Array<GridAggregationSelection>,
    treeMode: Boolean,
    issues: ArrayList<GridRestoreIssue>
): GridPivot? {
    val pivot = value ?: return None
    if (treeMode || aggregations.size == 0L) {
        issues.add(GridRestoreIssue(GridStatePart.Pivot, "树模式或缺少有效度量，透视已关闭"))
        return None
    }
    val seen = HashSet<GridColumnId>()
    val kept = ArrayList<GridSort>()
    for (dimension in pivot.dimensions) {
        var allowed = false
        when (columns.find(dimension.column)?.pivoting ?: None) {
            case Some(_) -> allowed = true
            case None -> {}
        }
        if (allowed && seen.add(dimension.column))
            kept.add(dimension)
        else
            issues.add(GridRestoreIssue(GridStatePart.Pivot, "透视维度重复、已移除或不允许透视"))
    }
    return Some(GridPivot(kept.toArray(), pivot.label))
}
